{
  "base": "http://127.0.0.1:3001",
  "steps": [
    {"url":"/heroes/83100","width":1440,"height":900,"shot":"elaina-desktop.png","assert":"!!document.querySelector('[data-hero-identity=\"83100\"]')"},
    {"assert":"getComputedStyle(document.querySelector('.hero-control')).minHeight === '44px' && getComputedStyle(document.querySelector('.element-badge')).borderTopWidth === '1px'"},
    {"clickText":"Cấp 1","within":"#breakthrough button","assert":"document.querySelectorAll('[data-total-element]').length === 0"},
    {"clickText":"Cấp 20","within":"#breakthrough button","assert":"!!document.querySelector('[data-total-element=\"water\"]')"},
    {"clickText":"Chưa đột phá","within":"#breakthrough button"},
    {"scrollTo":"#equipment","shot":"equipment-desktop.png"},
    {"click":"#equipment [aria-label=\"Biến thể thuộc tính\"] button:nth-child(4)"},
    {"clickText":"Trang bị bộ đang xem","within":"#equipment button","shot":"wind-equipped-desktop.png","assert":"document.querySelector('[data-equipped-element]').dataset.equippedElement === 'wind' && !!document.querySelector('[data-total-element=\"wind\"]') && !document.querySelector('[data-total-element=\"earth\"]')"},
    {"url":"/heroes/83100","width":390,"height":844,"shot":"elaina-mobile.png"},
    {"scrollTo":"#hero-overview","shot":"standing-mobile.png"},
    {"scrollTo":"#equipment","shot":"equipment-mobile.png"},
    {"click":"#equipment [aria-label=\"Biến thể thuộc tính\"] button:nth-child(4)"},
    {"clickText":"Trang bị bộ đang xem","within":"#equipment button","shot":"wind-equipped-mobile.png","assert":"document.querySelector('[data-equipped-element]').dataset.equippedElement === 'wind'"},
    {"reload":true,"assert":"document.querySelector('[data-equipped-element]').dataset.equippedElement === 'none'"},
    {"clickText":"Tối đa theo dữ liệu bản thể"},
    {"clickText":"Lv.1","within":"#level button","assert":"document.querySelector('[aria-label=\"Cấp tiến hoá\"]').max === '0' && document.querySelector('[aria-label=\"Cấp tiến hoá\"]').value === '0'"},
    {"click":"a[href=\"/heroes/83200\"]","assert":"document.querySelector('[data-hero-identity]').dataset.heroIdentity === '83200' && document.querySelector('[data-equipped-element]').dataset.equippedElement === 'none' && document.querySelector('[aria-label=\"Cấp độ tướng\"]').value === '1'"},
    {"url":"/heroes/83200","shot":"elaina-form-mobile.png"},
    {"clickText":"Tối đa theo dữ liệu bản thể","assert":"document.querySelector('#super-evolution').innerText.includes('Vàng')"},
    {"scrollTo":"#equipment","shot":"elaina-form-equipment-mobile.png","assert":"document.querySelector('[data-recommendations]').innerText.includes('Hỏa')"},
    {"url":"/heroes/83000","width":1440,"height":900,"shot":"shadow-desktop.png"},
    {"scrollTo":"#equipment","shot":"shadow-equipment-desktop.png","assert":"document.querySelector('[data-recommendations]').innerText.includes('Phong') && !document.querySelector('[data-recommendations]').innerText.includes('Địa (Thổ)')"},
    {"url":"/heroes/82400","width":390,"height":844,"shot":"nagato-mobile.png"},
    {"scrollTo":"#equipment","shot":"nagato-equipment-mobile.png","assert":"document.querySelector('[data-recommendations]').innerText.includes('Gedo Mazo')"},
    {"url":"/heroes/84000","width":390,"height":844,"shot":"sasuke-mobile.png"},
    {"clickText":"Tối đa theo dữ liệu bản thể"},
    {"scrollTo":"#breakthrough","shot":"breakthrough-mobile.png","assert":"document.querySelector('[aria-label=\"Cấp đột phá\"]').value === '20'"},
    {"clickText":"Chưa đột phá","within":"#breakthrough button","assert":"document.querySelector('[aria-label=\"Cấp đột phá\"]').value === '0'"},
    {"click":"a[href=\"/heroes/43900\"]","assert":"!document.querySelector('[aria-label=\"Cấp đột phá\"]') && document.querySelector('[data-equipped-element]').dataset.equippedElement === 'none'"},
    {"url":"/heroes/1","shot":"unsupported-mobile.png","assert":"!document.querySelector('#evolution') && !document.querySelector('#rebirth') && !document.querySelector('#super-evolution')"},
    {"url":"/heroes","width":390,"height":844,"shot":"heroes-mobile.png","assert":"!!document.querySelector('#skill-element-filter')"},
    {"url":"/heroes","width":1440,"height":900,"shot":"heroes-desktop.png"},
    {"select":{"selector":"[aria-label=\"Nghề của tướng\"]","value":"0"},"assert":"document.querySelectorAll('[data-hero-identity]').length > 0 && [...document.querySelectorAll('[data-hero-identity]')].every(e => e.innerText.includes('Nghề 0'))"},
    {"select":{"selector":"[aria-label=\"Nghề của tướng\"]","value":"all"}},
    {"select":{"selector":"[aria-label=\"Tộc của tướng\"]","value":"0"},"assert":"document.querySelectorAll('[data-hero-identity]').length > 0 && [...document.querySelectorAll('[data-hero-identity]')].every(e => e.innerText.includes('Tộc 0'))"},
    {"select":{"selector":"[aria-label=\"Tộc của tướng\"]","value":"all"}},
    {"select":{"selector":"#skill-element-filter","value":"wind"},"shot":"wind-filter-desktop.png","assert":"document.querySelectorAll('[data-hero-identity]').length > 0 && [...document.querySelectorAll('[data-hero-identity]')].every(e => !!e.querySelector('[data-element-id=\"wind\"]'))"},
    {"url":"/equipment/119705","width":390,"height":844,"shot":"wind-item-mobile.png","assert":"document.body.innerText.includes('Phong (Gió)')"},
    {"url":"/suits/1690","width":1440,"height":900,"shot":"wind-suit-desktop.png","assert":"document.querySelector('[data-set-bonuses]').innerText.includes('Phong công')"}
  ]
}
