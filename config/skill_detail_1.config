ck_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"29020":{"effect_talent":0.0,"attr_effect":100,"skill_icon":"s_anying_s2","cd":0,"rate":100,"skill_story":"Kĩ năng trước khi bị đánh: Đối toàn thể phe địch gây ra effect% ST ma pháp + 100% ST thuộc tính Phong. Cho bản thân 1 tầng \"Phóng Ma Lực\": Mỗi tầng \"Phóng Ma Lực\" giúp bản thân tăng 10% Lực Công ma pháp, tối đa chồng đến 1000%.","effect_lvchange":2.0,"is_learn":0,"sprite_py":"anying_s2","skill_name":"Kết Giới","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":500,"evo_story":"Điều kiện mở khóa: Đồng đội tiến cấp đến +2","skill_type":"KBEATTACK","attack_effect":"","is_evolution":29021,"resource_count":0,"evo_food":5000,"action":0,"resource_type":0},"76416":{"effect_talent":0.0,"attr_effect":700,"skill_icon":"s_xzuozhu_s1","cd":2,"rate":100,"skill_story":"Gây ra effect% ST ma pháp và 700% ST thuộc tính Hỏa cho toàn phe địch","effect_lvchange":8.0,"is_learn":0,"sprite_py":"xzuozhu_s1","skill_name":"Ném Kunai - Giai 7","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1100,"evo_story":"Điều kiện tiến cấp: Đồng đội tiến cấp đến +41","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":76417,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"75417":{"effect_talent":0.0,"attr_effect":800,"skill_icon":"s_anying_s1","cd":2,"rate":100,"skill_story":"Đối toàn thể phe địch gây ra effect% ST ma pháp + 800% ST thuộc tính Phong","effect_lvchange":10.0,"is_learn":0,"sprite_py":"anying_s1","skill_name":"Thập Tự Trảm - giai 8","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1200,"evo_story":"Yêu cầu: Tiến hóa +50","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"7701600":{"effect_talent":0.0,"attr_effect":700,"skill_icon":"s_vegettopf_s1","cd":2,"rate":100,"skill_story":"Gây ra effect% ST vật lý và 700% ST thuộc tính Hỏa cho toàn phe địch.","effect_lvchange":8.0,"is_learn":0,"sprite_py":"vegetto_s1","skill_name":"Đạn Năng Lượng - Giai 7","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1100,"evo_story":"Điều kiện tiến cấp: Đồng đội tiến cấp đến +41","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":77017,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"74850":{"effect_talent":0.0,"attr_effect":1200,"skill_icon":"s_peien_s5","cd":1,"rate":100,"skill_story":"Kĩ năng trước lượt đấu: Tay bóp vẫn thạch. Gây ra effect% ST thực ma pháp và 800% ST thực thuộc tính Thổ. Hồi 50% HP cho bản thân (bỏ qua Trọng Thương)","effect_lvchange":10.0,"is_learn":0,"sprite_py":"peien_s5","skill_name":"Địa Bạo Thiên Tinh","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"75016":{"effect_talent":0.0,"attr_effect":850,"skill_icon":"s_telankesi_s1","cd":2,"rate":100,"skill_story":"Kĩ năng trước khi bị đánh: Gây ra effect% ST ma pháp và 700% ST thuộc tính Hỏa. Nhận 2 tầng \"Hộ Giá\", duy trì 3 lượt. \nHộ Giá: Tiêu trừ 1 lần ST trực tiếp (ST truy kích, ST 4 thuộc tính, Diệt Ngay không thể dùng Hộ Giá để chặn);\nHiệu quả bị động:\n1: Càng chiến càng mạnh: Khi bản thân còn sống trên chiến trường, trước lượt đấu Broli sẽ nhận được hiệu quả Trói Buộc, cấm mục tiêu sử dụng Kĩ năng trước khi bị đánh 1 lượt.\n2: Ngộ phú đấu năng: Khi bản thân còn trên chiến trường, trước khi chiến đấu Goku mới sẽ nhận được hiệu quả Trói Buộc, cấm mục tiêu sử dụng Kĩ năng trước khi bị đánh 1 lượt.\n3. Thầy bạn như tri kỉ: Khi bản thân còn trên chiến trường, Kĩ năng trước khi bị đánh của Songohan sẽ gây ra thêm gấp 8 lần ST và hiệu quả \"Ổn Định\"\n4: Thanh kiếm Hi Vọng: Khi Broli/ Songoku/ Songohan còn trên chiến trường, kĩ năng trước khi chiến đấu của Trunks sẽ khiến mục tiêu mất 1 lần sổ lần max có thể kích hoạt kĩ năng trước khi bị đánh.\n5: Trái tim Saiya: Khi 4 người cùng tồn tại trên chiến trường, lần Hồi Sinh đầu tiên không bị trừ vào số lần hồi sinh.","effect_lvchange":8.0,"is_learn":0,"sprite_py":"telankesi_s1","skill_name":"Gánh Lên - Giai 7","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1100,"evo_story":"Yêu cầu: Tiến hóa+41","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":75017,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"537700":{"effect_talent":0.0,"attr_effect":100,"skill_icon":"s_laoshuyao","cd":1,"rate":100,"skill_story":"Kĩ năng trước lượt đấu:\nGây ra effect% ST thực vật lý, gây ra ST truy kích theo mốc ở lượt hiện tại","effect_lvchange":0.3,"is_learn":0,"sprite_py":"boss_shenshixiang2_s2","skill_name":"Nahema","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1000,"evo_story":"","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"74860":{"effect_talent":0.0,"attr_effect":1200,"skill_icon":"s_peien_s6","cd":0,"rate":100,"skill_story":"Kĩ năng tử vong: Thông qua Địa Ngục hồi sinh bản thân, hồi toàn bộ HP (bỏ qua Trọng Thương). Gây ra effect% ST thực ma pháp và 1500% ST thực thuộc tính Thổ, tối đa có thể Hồi Sinh 3 lần. Diệt Ngay 1 đơn vị ngẫu nhiên","effect_lvchange":10.0,"is_learn":0,"sprite_py":"peien_s6","skill_name":"Diêm Vương Luân Hồi Phục Sinh","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"","skill_type":"KDEAD","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"76910":{"effect_talent":0.0,"attr_effect":550,"skill_icon":"s_xiangkesi2_s1","cd":3,"rate":50,"skill_story":"对敌方全体造成effect%的魔法伤害和800%的风属性伤害。凝聚1层“霸王色霸气”。","effect_lvchange":2.0,"is_learn":0,"sprite_py":"xiangkesi2_s1","skill_name":"斩击","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":500,"evo_story":"","skill_type":"KBEFOREATTACK","attack_eff