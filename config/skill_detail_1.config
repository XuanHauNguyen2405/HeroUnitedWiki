ều kiện tiến cấp: Đồng đội tiến cấp đến +45","skill_type":"KBEFOREHERT","attack_effect":"","is_evolution":29037,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"29037":{"effect_talent":0.0,"attr_effect":900,"skill_icon":"s_anying_s3","cd":2,"rate":100,"skill_story":"Kĩ năng phản kích: Đối toàn thể phe địch gây ra effect% ST ma pháp + 900% ST thuộc tính Phong. Dưới tác dụng của \"Hình thái Shadow\", truy kích thêm ST bằng 50% HP tối đa. Gây ra effect% ST ma pháp và 900% ST thuộc tính Hỏa. Mục tiêu mỗi có 1 tầng \"Tách\" thì truy kích thêm ST bằng 10% HP tối đa.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"anying_s3","skill_name":"Phản Trảm - giai 8","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1200,"evo_story":"Điều kiện tiến cấp: Đồng đội tiến cấp đến +60","skill_type":"KBEFOREHERT","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"75837":{"effect_talent":0.0,"attr_effect":900,"skill_icon":"s_beijita_s3","cd":2,"rate":100,"skill_story":"Kỹ năng phản kích: Tất cả tấn công thuộc tính chuyển thành thuộc tính Địa. Gây ra effect% ST ma pháp và 900% ST thuộc tính Địa","effect_lvchange":10.0,"is_learn":0,"sprite_py":"beijita2_s3","skill_name":"Đạn chớp năng lượng - Giai 8","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1200,"evo_story":"Yêu cầu: Tiến hóa +60","skill_type":"KBEFOREHERT","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"29040":{"effect_talent":0.0,"attr_effect":1200,"skill_icon":"s_anying_s4","cd":2,"rate":100,"skill_story":"Khống chế ma lực lưu động tạo thành cộng chấn, đối toàn thể phe địch gây ra effect% ST ma pháp thực và 1200% ST thực thuộc tính Phong. Dưới tác dụng của \"Hình thái Shadow\", xóa bỏ ngẫu nhiên lượt Hồi Sinh của 1 người, số lượt Hồi Sinh bị xóa bằng số lượt Hồi Sinh bản thân đã dùng (tối đa 4 lần), và Diệt Ngay đối phương.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"anying_s4","skill_name":"Ma Lực Rung Động","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"Tiêu Xu sẽ mở skill này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"29416":{"effect_talent":0.0,"attr_effect":700,"skill_icon":"s_hudieren_s1","cd":2,"rate":100,"skill_story":"Gây ra effect% ST ma pháp và 700% ST thuộc tính Thủy cho toàn phe địch","effect_lvchange":8.0,"is_learn":0,"sprite_py":"hudieren_s1","skill_name":"Đột Kích - Giai 7","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1100,"evo_story":"Điều kiện tiến cấp: Đồng đội tiến cấp đến +41","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":29417,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"534900":{"effect_talent":0.0,"attr_effect":230,"skill_icon":"s_lingnengzhiren","cd":0,"rate":100,"skill_story":"Kĩ năng trước khi bị đánh: Giảm tất cả tấn công thuộc tính của phe địch về 0, giảm Trúng Đích về 0. Vô Địch 1 lượt.","effect_lvchange":4.0,"is_learn":0,"sprite_py":"boss_jiegeng_s1","skill_name":"Kết Giới","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1000,"evo_story":"","skill_type":"KBEATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"76150":{"effect_talent":0.0,"attr_effect":1800,"skill_icon":"s_xsjsuolong2_s5","cd":1,"rate":100,"skill_story":"Kĩ năng trước lượt đấu: Gây ra ST thực bằng effect% tấn công vật lý và 1800% ST thuộc tính Phong cho toàn phe địch. Gây ra ST truy kích cho mục tiêu bằng 100% HP max của bản thân. Nhận 1 tầng \"Chiến Ý\"","effect_lvchange":10.0,"is_learn":0,"sprite_py":"xsjsuolong2_s5","skill_name":"Daisenka Sekai","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"29417