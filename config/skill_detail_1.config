0000,"action":0,"resource_type":0},"77026":{"effect_talent":0.0,"attr_effect":700,"skill_icon":"s_vegetto_s2","cd":0,"rate":100,"skill_story":"Kĩ năng cảm tri: Trước khi gặp phải tấn công của phe địch, nhận 1 tầng \"Gợi Đòn\"; Hồi 48% ST max; Nhận hiệu ứng bị động: Tăng kĩ năng trước lượt đấu của phe Ngọc Rồng và hiệu ứng kĩ năng Hồi Sinh: Nếu có Vegito trong trận, được Diệt Ngay thêm 1 kẻ địch; nhận hiệu ứng \"Ổn Định\".\nPhe Ngọc Rồng bao gồm: Cuồng - Broli/ Kakalot/Gohan Dã Thú/Kiếm Hy Vọng/Vegeta.(Hiệu ứng Skin: Thẻ Phe không nhận Bị Động nữa; bản thân nhận 2 tầng Gợi Đòn, lượng HP max được hồi phục lên tới 100%)","effect_lvchange":8.0,"is_learn":0,"sprite_py":"vegetto_s2","skill_name":"Tự Tại Cực Ý Công - Giai 7","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1100,"evo_story":"Điều kiện tiến cấp: Đồng đội tiến cấp đến +43","skill_type":"KBEATTACK","attack_effect":"","is_evolution":77027,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"74912":{"effect_talent":0.0,"attr_effect":650,"skill_icon":"s_peien2_s1","cd":3,"rate":100,"skill_story":"Gây ra effect% ST ma pháp và 500% ST thuộc tính Thổ cho toàn phe địch","effect_lvchange":3.0,"is_learn":0,"sprite_py":"peien2_s1","skill_name":"Tổ Hợp Nhẫn Thuật - Phong Hỏa - Giai 3","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":6,"effect":700,"evo_story":"Yêu cầu: Tiến hóa +16","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":74913,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"75935":{"effect_talent":0.0,"attr_effect":750,"skill_icon":"s_beijita2_s3","cd":2,"rate":100,"skill_story":"反击技:所有属性攻击力转化为地属性攻击力，对目标造成effect%的魔法伤害和700%的地属性伤害。","effect_lvchange":5.0,"is_learn":0,"sprite_py":"beijita2_s3","skill_name":"能量飞弹·六阶","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1000,"evo_story":"Yêu cầu: Tiến hóa+40","skill_type":"KBEFOREHERT","attack_effect":"","is_evolution":75936,"resource_count":0,"evo_food":60000,"action":0,"resource_