nt":0.0,"attr_effect":1200,"skill_icon":"s_vegettopf_s5","cd":1,"rate":100,"skill_story":"Kĩ năng trước lượt đấu: Gây ra ST thực bằng effect% tấn công vật lý và 1500% ST thuộc tính Hỏa cho kẻ địch. Hồi 100% HP max bản thân. Mỗi một đồng đội thuộc phe Ngọc Rồng có trong trận sẽ giúp kĩ năng này gây thêm ST truy kích bằng 10% HP max bản thân.(Hiệu ứng Skin: Không cần có đồng đội cùng phe Ngọc Rồng cũng có thể trực tiếp Truy Kích với ST bằng 40% HP max, Chuyển Sinh sẽ tăng gấp bội)","effect_lvchange":10.0,"is_learn":0,"sprite_py":"vegetto_s5","skill_name":"Kiếm nguyên khí","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"Tiêu Xu sẽ mở skill này","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"29170":{"effect_talent":0.0,"attr_effect":1800,"skill_icon":"s_yileina_s7","cd":99,"rate":100,"skill_story":"Kĩ năng trước chiến đấu: Áp súc ma pháp và tăng cường hiệu quả Chém Đứt, Lực công của tất cả thuộc tính đều chuyển thành Lực công thuộc tính Phong; Gây ra ST thực gồm effect% ST ma pháp và 1800% ST thuộc tính Phong cho toàn thể phe địch","effect_lvchange":10.0,"is_learn":0,"sprite_py":"yileina_s7","skill_name":"Chém Đứt Không Khí","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"","skill_type":"KBEFOREBATTLE","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"76750":{"effect_talent":0.0,"attr_effect":1800,"skill_icon":"s_mlads2_s5","cd":1,"rate":100,"skill_story":"Kĩ năng trước lượt đấu: Gây ra ST thực bằng effect% tấn công ma pháp và 1500% ST thuộc tính Địa cho toàn phe địch. Hồi 100% HP bản thân. Ngưng tự 1 tầng \"Sức Mạnh Ma Thần\" và khiến số tầng \"Sức Mạnh Ma Thần\" của bản thân tăng gấp đôi. Dùng 1 tầng \"Sức Mạnh Ma Thần\" của bản thân gây ra ST truy kích bằng 50% HP max của bản thân.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"mlads2_s5","skill_name":"Ma Thần Bộc P