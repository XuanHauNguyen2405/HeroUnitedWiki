T","attack_effect":"","is_evolution":28836,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"28836":{"effect_talent":0.0,"attr_effect":800,"skill_icon":"s_telankesi_s3","cd":2,"rate":100,"skill_story":"Kĩ năng phản kích: Gây ra effect% ST ma pháp và 800% ST thuộc tính Hỏa cho toàn phe địch","effect_lvchange":8.0,"is_learn":0,"sprite_py":"telankesi_s3","skill_name":"Thái Dương Kiếm - Giai 7","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1100,"evo_story":"Điều kiện tiến cấp: Đồng đội tiến cấp đến +45","skill_type":"KBEFOREHERT","attack_effect":"","is_evolution":28837,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"28837":{"effect_talent":0.0,"attr_effect":900,"skill_icon":"s_telankesi_s3","cd":2,"rate":100,"skill_story":"Kĩ năng phản kích: Gây ra effect% ST ma pháp và 900% ST thuộc tính Hỏa cho toàn phe địch","effect_lvchange":10.0,"is_learn":0,"sprite_py":"telankesi_s3","skill_name":"Thái Dương Kiếm - Giai 8","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1200,"evo_story":"Điều kiện tiến cấp: Đồng đội tiến cấp đến +60","skill_type":"KBEFOREHERT","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"75121":{"effect_talent":0.0,"attr_effect":300,"skill_icon":"s_telankesi2_s2","cd":0,"rate":100,"skill_story":"Kĩ năng trước khi bị đánh: Gây ra effect% ST ma pháp và 200% ST thuộc tính Hỏa cho toàn phe địch.Nhận 2 tầng \"Hộ Giá\", duy trì 3 lượt.Hộ Giá: Chắn các ST trực tiếp từ địch 1 lần. (ST truy kích, ST 4 thuộc tính, Diệt Ngay, không thể dùng Hộ Giá chắn);\nHiệu quả bị động (không cần đeo kĩ năng này):\n1: Càng đánh càng mạnh: Khi bản thân còn trên chiến trường, trước khi bắt đầu lượt đấu Broli nhận buff Trói Buộc, cấm kĩ năng trước khi bị đánh của mục tiêu 1 lượt.\n2: Tăng chiến lực: Khi bản thân còn trên chiến trường, trước khi chiến đấu Songoku mới nhận hiệu quả Trói Buộc, cấm kĩ năng trước khi bị đánh của mục tiêu 1 lượt.\n3: Như thầy như bạn: Khi bản thân còn trên chiến trường, trước khi bị đánh Songohan nhận thêm 8 lần ST và hiệu quả \"Ổn Định\".\n4: Thanh Gươm Hy Vọng: Khi Broli/ Songoku/ Songohan còn trên chiến trường, kĩ năng trước khi chiến đấu của Trunks sẽ khiến mục tiêu mất 1 lượt giới hạn kĩ năng trước khi bị đánh.\n5: Trái tim Saiya: Khi 4 người đều còn trên chiến trường, lần Hồi Sinh đầu tiên không mất lượt Hồi Sinh.","effect_lvchange":2.0,"is_learn":0,"sprite_py":"telankesi2_s2","skill_name":"Siêu Saiyan - Nộ - Giai 2","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":5,"effect":600,"evo_story":"Yêu cầu: Tiến hóa +11","skill_type":"KBEATTACK","attack_effect":"","is_evolution":75122,"resource_count":0,"evo_food":30000,"action":0,"resource_type":0},"28840":{"effect_talent":0.0,"attr_effect":1200,"skill_icon":"s_telankesi_s4","cd":2,"rate":100,"skill_story":"Gây ra effect% ST thực ma pháp và 1200% ST thực thuộc tính Hỏa cho toàn phe địch. Diệt Ngay ngẫu nhiên 1 người","effect_lvchange":10.0,"is_learn":0,"sprite_py":"telankesi_s4","skill_name":"Liệt Diệm Xung Kích","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"Tiêu Xu sẽ mở skill này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"73725":{"effect_talent":0.0,"attr_effect":800,"skill_icon":"s_XWukong2_s2","cd":0,"rate":100,"skill_story":"Nếu sử dụng skin \"Songoku Siêu Xayda 3\": Kỹ năng trước khi bị tấn công: Hồi phục toàn bộ HP bản thân (bỏ qua Trọng Thương), giảm 100% tỉ lệ Trúng Đích của mục tiêu; có được một tầng \"Hộ Giá\".","effect_lvchange":5.0,"is_learn":0,"sprite_py":"XWukong2_s2","skill_name":"Cảm Thụ Khí - Giai 6","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1000,"evo_story":"Yêu cầu: Tiến hóa+39","skill_type":"KBEATTACK","attack_effect":"","is_evolution":73726,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"534700":{"effect_talent":0.0,"attr_effect":100,"skill_icon":"s_laoshuyao","cd":1,"rate":100,"skill_story":"Kĩ năng trước lượt đấu:\nGây ra effect% ST ma pháp và 900% ST thực thuộc tính Hỏa cho toàn phe địch. Trói Buộc tất cả mục tiêu. Gây ra ST Truy Kích theo mốc lượt đấu hiện tại","effect_lvchange":0.3,"is_learn":0,"sprite_py":"boss_renzaoren18hao_s2","skill_name":"Pháo Năng Nguyên","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1000,"evo_story":"","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"75122":{"effect_talent":0.0,"attr_effect":400,"skill_icon":"s_telankesi2_s2","cd":0,"rate":100,"skill_story":"Kĩ năng trước khi bị đánh: Gây ra effect% ST ma pháp và 300% ST thuộc tính Hỏa cho toàn phe địch.Nhận 2 tầng \"Hộ Giá\", duy trì 3 lượt.Hộ Giá: Chắn các ST trực tiếp từ địch 1 lần. (ST truy kích, ST 4 thuộc tính, Diệt Ngay, không thể dùng Hộ Giá chắn);\nHiệu quả bị động (không cần đeo kĩ năng này):\n1: Càng đánh càng mạnh: Khi bản thân còn trên chiến trường, trước khi bắt đầu lượt đấu Broli nhận buff Trói Buộc, cấm kĩ năng trước khi bị đánh của mục tiêu 1 lượt.\n2: Tăng chiến lực: Khi bản thân còn trên chiến trường, trước khi chiến đấu Songoku mới nhận hiệu quả Trói Buộc, cấm kĩ năng trước khi bị đánh của mục tiêu 1 lượt.\n3: Như thầy như bạn: Khi bản thân còn trên chiến trường, trước khi bị đánh Songohan nhận thêm 8 lần ST và hiệu quả \"Ổn Định\".\n4: Thanh Gươm Hy Vọng: Khi Broli/ Songoku/ Songohan còn trên chiến trường, kĩ năng trước khi chiến đấu của Trunks sẽ khiến mục tiêu mất 1 lượt giới hạn kĩ năng trước khi bị đánh.\n5: Trái tim Saiya: Khi 4 người đều còn trên chiến trường, lần Hồi Sinh đầu tiên không mất lượt Hồi Sinh.","effect_lvchange":3.0,"is_learn":0,"sprite_py":"telankesi2_s2","skill_name":"Siêu Saiyan - Nộ - Giai 3","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":6,"effect":700,"evo_story":"Yêu cầu: Tiến hóa +19","skill_type":"KBEATTACK","attack_effect":"","is_evolution":75123,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"75950":{"effect_talent":0.0,"attr_effect":1800,"skill_icon":"s_beijita2_s5","cd":1,"rate":100,"skill_story":"回合前技：对敌方造成effect%的魔法攻击真伤与1800%地属性伤害真实伤害。造成自身70%最大生命值的追击伤害。“极意悟吉塔”状态下，额外秒杀一名随机单位。","effect_lvchange":10.0,"is_learn":0,"sprite_py":"beijita2_s5","skill_name":"王子战法","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"28360":{"effect_talent":0.0,"attr_effect":1200,"skill_icon":"s_shenshixiang_s6","cd":0,"rate":100,"skill_story":"Kĩ năng tử vong: Tohka giải phóng toàn bộ Linh Lực của bản thân, đồng thời mất khống chế sức mạnh của mình. Hồi phục toàn bộ HP bản thân (bỏ qua Trọng Thương), gây ra effect% ST thực vật lý và 1200% ST thực thuộc tính Thủy, tối đa có thể Hồi Sinh 2 lần. Diệt Ngay ngẫu nhiên 1 đơn vị.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"shenshixiang_s6","skill_name":"Linh Năng Cuồng Bạo","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"","skill_type":"KDEAD","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"28850":{"effect_talent":0.0,"attr_effect":1200,"skill_icon":"s_telankesi_s5","cd":1,"rate":100,"skill_story":"Kĩ năng trước lượt đấu: Gây ra effect% ST thực ma pháp và 1800% ST thực thuộc tính Hỏa cho toàn phe địch, hồi phục 50% HP bản thân (bỏ qua Trọng Thương)","effect_lvchange":10.0,"is_learn":0,"sprite_py":"telankesi_s5","skill_name":"Kiếm Thiết Kích","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"Tiêu Xu sẽ mở skill này","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"29726":{"effect_talent":0.0,"attr_effect":700,"skill_icon":"s_xiangkesi_s2","cd":0,"rate":100,"skill_story":"感知技：作为“四皇”之一的红发，所有人都愿意给香克斯一个面子；在受到敌人攻击前，获得“招架