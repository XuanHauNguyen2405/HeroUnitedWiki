,"rate":100,"skill_story":"Kĩ năng trước lượt đấu: Gây ra ST thực bằng effect% tấn công ma pháp và 1500% ST thuộc tính Địa cho toàn phe địch. Hồi 100% HP bản thân. Ngưng tự 1 tầng \"Sức Mạnh Ma Thần\". Dùng 1 tầng \"Sức Mạnh Ma Thần\" của bản thân gây ra ST truy kích bằng 50% HP max của bản thân.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"mlads_s5","skill_name":"Cắt Kim Loại","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"Tiêu Xu sẽ mở skill này","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"74915":{"effect_talent":0.0,"attr_effect":800,"skill_icon":"s_peien2_s1","cd":2,"rate":100,"skill_story":"Gây ra effect% ST ma pháp và 700% ST thuộc tính Thổ cho toàn phe địch","effect_lvchange":5.0,"is_learn":0,"sprite_py":"peien2_s1","skill_name":"Tổ Hợp Nhẫn Thuật - Phong Hỏa - Giai 6","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1000,"evo_story":"Yêu cầu: Tiến hóa+37","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":74916,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"76760":{"effect_talent":0.0,"attr_effect":1500,"skill_icon":"s_mlads2_s6","cd":0,"rate":100,"skill_story":"Kĩ năng tử vong: Hồi toàn bộ HP bản thân (bỏ qua Trọng Thương). Gây ra ST thực bằng effect% tấn công ma pháp và 1500% ST thuộc tính Địa cho toàn phe địch, tối đa Hồi Sinh 3 lần. Diệt Ngay 1 mục tiêu ngẫu nhiên phe địch. Dùng 3 tầng \"Sức Mạnh Ma Thần\" để Diệt Ngay thêm 1 mục tiêu.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"mlads2_s6","skill_name":"Sức Mạnh Ma Thần MAX","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"","skill_type":"KDEAD","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"29860":{"effect_talent":0.0,"attr_effect":1200,"skill_icon":"s_vegetto_s6","cd":0,"rate":100,"skill_story":"Kĩ năng tử vong: Khi Hồi Sinh sẽ dựa vào số