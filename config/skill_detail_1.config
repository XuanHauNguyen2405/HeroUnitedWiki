":30000,"action":0,"resource_type":0},"536600":{"effect_talent":0.0,"attr_effect":280,"skill_icon":"s_kuangyezhifeng","cd":99,"rate":100,"skill_story":"Kĩ năng trước chiến đấu: \nVĩnh viễn tăng 79% Giảm Thương chỉnh thể, tăng 500% Trúng Đích, Né Tránh và Bạo Kích, gây ra effect% ST ma pháp và 1200% ST thực thuộc tính Thổ. Loại bỏ 4 lần Hồi Sinh trên sàn đấu.","effect_lvchange":3.0,"is_learn":0,"sprite_py":"boss_xiatiya2_s3","skill_name":"Ngọn Thương Thanh Tẩy","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1000,"evo_story":"","skill_type":"KBEFOREBATTLE","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"28335":{"effect_talent":0.0,"attr_effect":750,"skill_icon":"s_shenshixiang_s3","cd":2,"rate":100,"skill_story":"Kĩ năng phản kích: Sau khi Tohka bị thương sẽ tiến hành phản kích, gây ra effect% ST vật lý và 750% ST thuộc tính Thủy","effect_lvchange":5.0,"is_learn":0,"sprite_py":"shenshixiang_s3","skill_name":"Phản Kích Năng Lượng - Giai 6","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1000,"evo_story":"Điều kiện tiến cấp: Đồng đội tiến cấp đến +40","skill_type":"KBEFOREHERT","attack_effect":"","is_evolution":28336,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"76024":{"effect_talent":0.0,"attr_effect":500,"skill_icon":"s_xsjsuolong_s2","cd":0,"rate":100,"skill_story":"Kĩ năng trước khi bị đánh: Tăng 500% Lực Phòng toàn thuộc tính của bản thân; Gây ra effect% ST vật lý và 500% ST thuộc tính Phong cho toàn phe địch. Nhận 1 tầng \"Chiến Ý'. Bị động: Mỗi tầng \"Chiến Ý\" tăng 20% chỉnh thể ST từ tất cả các kĩ năng của bản thân.","effect_lvchange":4.0,"is_learn":0,"sprite_py":"xsjsuolong_s2","skill_name":"Vòi Rồng - Giai 5","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":900,"evo_story":"Yêu cầu: Tiến hóa+34","skill_type":"KBEATTACK","attack_effect":"","is_evolution":76025,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"737310