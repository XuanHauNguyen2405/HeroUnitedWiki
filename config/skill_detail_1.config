g - Broli/ Kakalot/Gohan Dã Thú/Kiếm Hy Vọng/Vegeta.(Hiệu ứng Skin: Thẻ Phe không nhận Bị Động nữa; bản thân nhận 2 tầng Gợi Đòn, lượng HP max được hồi phục lên tới 100%)","effect_lvchange":3.0,"is_learn":0,"sprite_py":"vegetto_s2","skill_name":"Phòng hộ năng lượng - Giai 3","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":6,"effect":700,"evo_story":"Điều kiện tiến cấp: Đồng đội tiến cấp đến +20","skill_type":"KBEATTACK","attack_effect":"","is_evolution":77023,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"75450":{"effect_talent":0.0,"attr_effect":1200,"skill_icon":"s_anying_s5","cd":1,"rate":100,"skill_story":"Kĩ năng trước lượt đấu: Lợi dụng thao tác ma lực đến cực hạn, mô phỏng Nổ Hạt Nhân. Đối toàn thể phe địch gây ra effect% ST ma pháp thực và 1800% ST thực thuộc tính Phong. Dưới tác dụng của \"Hình thái Shadow\", nhận hiệu ứng \"Ổn Định\"","effect_lvchange":10.0,"is_learn":0,"sprite_py":"anying_s5","skill_name":"Atomic","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"76027":{"effect_talent":0.0,"attr_effect":800,"skill_icon":"s_xsjsuolong_s2","cd":0,"rate":100,"skill_story":"Kĩ năng trước khi bị đánh: Tăng 500% Lực Phòng toàn thuộc tính của bản thân; Gây ra effect% ST vật lý và 800% ST thuộc tính Phong cho toàn phe địch. Nhận 1 tầng \"Chiến Ý'. Bị động: Mỗi tầng \"Chiến Ý\" tăng 20% chỉnh thể ST từ tất cả các kĩ năng của bản thân.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"xsjsuolong_s2","skill_name":"Vòi Rồng - Giai 8","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1200,"evo_story":"Yêu cầu: Tiến hóa +55","skill_type":"KBEATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"75460":{"effect_talent":0.0,"attr_effect":1200,"skill_icon":"s_anying_s6","cd":0,"rate":100,"sk