,"evo_food":0,"action":0,"resource_type":0},"76226":{"effect_talent":0.0,"attr_effect":700,"skill_icon":"s_hudieren_s2","cd":0,"rate":100,"skill_story":"Kĩ năng trước khi bị đánh:Gây ra effect% ST ma pháp cho toàn phe địch. Bản thân tăng 50% Né Tránh, có thể chồng;","effect_lvchange":8.0,"is_learn":0,"sprite_py":"hudieren_s2","skill_name":"Hơi Thở Của Côn Trùng - Giai 7","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1100,"evo_story":"Điều kiện tiến cấp: Đồng đội tiến cấp đến +43","skill_type":"KBEATTACK","attack_effect":"","is_evolution":76227,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"75011":{"effect_talent":0.0,"attr_effect":600,"skill_icon":"s_telankesi_s1","cd":3,"rate":100,"skill_story":"Kĩ năng trước khi bị đánh: Gây ra effect% ST ma pháp và 200% ST thuộc tính Hỏa. Nhận 2 tầng \"Hộ Giá\", duy trì 3 lượt. \nHộ Giá: Tiêu trừ 1 lần ST trực tiếp (ST truy kích, ST 4 thuộc tính, Diệt Ngay không thể dùng Hộ Giá để chặn);\nHiệu quả bị động:\n1: Càng chiến càng mạnh: Khi bản thân còn sống trên chiến trường, trước lượt đấu Broli sẽ nhận được hiệu quả Trói Buộc, cấm mục tiêu sử dụng Kĩ năng trước khi bị đánh 1 lượt.\n2: Ngộ phú đấu năng: Khi bản thân còn trên chiến trường, trước khi chiến đấu Goku mới sẽ nhận được hiệu quả Trói Buộc, cấm mục tiêu sử dụng Kĩ năng trước khi bị đánh 1 lượt.\n3. Thầy bạn như tri kỉ: Khi bản thân còn trên chiến trường, Kĩ năng trước khi bị đánh của Songohan sẽ gây ra thêm gấp 8 lần ST và hiệu quả \"Ổn Định\"\n4: Thanh kiếm Hi Vọng: Khi Broli/ Songoku/ Songohan còn trên chiến trường, kĩ năng trước khi chiến đấu của Trunks sẽ khiến mục tiêu mất 1 lần sổ lần max có thể kích hoạt kĩ năng trước khi bị đánh.\n5: Trái tim Saiya: Khi 4 người cùng tồn tại trên chiến trường, lần Hồi Sinh đầu tiên không bị trừ vào số lần hồi sinh.\n","effect_lvchange":2.0,"is_learn":0,"sprite_py":"telankesi_s1","skill_name":"Gánh Lên - Giai 2","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":5,"effect":600,"evo_story":"Yêu cầu: Tiến hóa +9","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":75012,"resource_count":0,"evo_food":30000,"action":0,"resource_type":0},"28421":{"effect_talent":0.0,"attr_effect":600,"skill_icon":"s_dieqi_s2","cd":0,"rate":100,"skill_story":"Kĩ năng trước khi bị đánh: Inori thông qua quan sát tần số của phe địch, tăng 100% Né Tránh của bản thân, có thể chồng Né Tránh. Hồi phục 32% HP tối đa cho bản thân. ","effect_lvchange":2.0,"is_learn":0,"sprite_py":"dieqi_s2","skill_name":"Cảm Nhận Tần Số - Giai 2","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":5,"effect":600,"evo_story":"Điều kiện tiến cấp: Đồng đội tiến cấp đến +11","skill_type":"KBEATTACK","attack_effect":"","is_evolution":28422,"resource_count":0,"evo_food":30000,"action":0,"resource_type":0},"75625":{"effect_talent":0.0,"attr_effect":600,"skill_icon":"s_yileina_s2","cd":0,"rate":100,"skill_story":"Kĩ năng trước khi bị tấn công: Lực công của tất cả thuộc tính đều chuyển thành Lực công thuộc tính Phong, gây ra effect% ST ma pháp và 600% ST thuộc tính Phong cho toàn thể phe địch. Gây thêm 1 tầng \"Phù Không\": Khi bị dẫn nổ sẽ khiến mục tiêu không thể phóng kĩ năng trước khi bị tấn công.","effect_lvchange":5.0,"is_learn":0,"sprite_py":"yileina_s2","skill_name":"Gió Lốc - giai 6","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1000,"evo_story":"Yêu cầu: Tiến hóa+39","skill_type":"KBEATTACK","attack_effect":"","is_evolution":75626,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"76840":{"effect_talent":0.0,"attr_effect":1200,"skill_icon":"s_xiangkesi_s4","cd":2,"rate":100,"skill_story":"对敌方造成effect%的魔法攻击真伤与1800%风属性伤害真实伤害。凝聚1层“霸王色霸气”。","effect_lvchange":10.0,"is_learn":0,"sprite_py":"xiangkesi_s4","skill_name":"武装色霸气","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"Tiêu Xu sẽ mở skill này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"77060":{"effect_talent":0.0,"attr_effect":1200,"skill_icon":"s_vegetto_s6","cd":0,"rate":100,"skill_story":"Kĩ năng Tử Vong: Khi Hồi Sinh sẽ có tăng tỉ lệ không tốn số lần Hồi Sinh dựa theo số người cùng phe Ngọc Rồng có trên trường đấu, mỗi 1 người tăng 10% (Hiệu ứng Skin: Không cần có đồng đội cùng phe Ngọc Rồng trên trận, có tỉ lệ 40% được Hồi Sinh không tốn số lượt, sau khi Chuyển Sinh tăng lên 60%); Hồi toàn bộ HP bản thân (bỏ qua Trọng Thương). Gây ra ST thật bằng effect% tấn công ma pháp và 1500% ST thuộc tính Hoả cho toàn phe địch, tối đa Hồi Sinh 3 lần. Diệt Ngay ngẫu nhiên 1 mục tiêu phe địch.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"vegetto_s6","skill_name":"Xóa Sổ","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"","skill_type":"KDEAD","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"76431":{"effect_talent":0.0,"attr_effect":300,"skill_icon":"s_xzuozhu_s3","cd":3,"rate":100,"skill_story":"Kĩ năng phản kích: Gây ra effect% ST ma pháp và 300% ST thuộc tính Hỏa cho toàn phe địch","effect_lvchange":2.0,"is_learn":0,"sprite_py":"xzuozhu_s3","skill_name":"Cường Hóa Đánh Nhanh - Giai 2","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":5,"effect":600,"evo_story":"Điều kiện tiến cấp: Đồng đội tiến cấp đến +14","skill_type":"KBEFOREHERT","attack_effect":"","is_evolution":76432,"resource_count":0,"evo_food":30000,"action":0,"resource_type":0},"74926":{"effect_talent":0.0,"attr_effect":800,"skill_icon":"s_peien2_s2","cd":0,"rate":100,"skill_story":"Kĩ năng trước khi bị đánh: Nhận 2 tầng \"Hộ Giá\", duy trì 3 lượt. Gây ra effect% ST ma pháp và 700% ST thuộc tính Thủy cho toàn phe địch. Hộ Giá: Chắn các ST trực tiếp từ địch (ST truy kích, ST thuộc tính, ST diệt ngay không thể chắn) 1 lần","effect_lvchange":8.0,"is_learn":0,"sprite_py":"peien2_s2","skill_name":"Tổ Hợp Nhẫn Thuật - Lôi Thủy - Giai 7","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1100,"evo_story":"Yêu cầu: Tiến hóa+43","skill_type":"KBEATTACK","attack_effect":"","is_evolution":74927,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"75013":{"effect_talent":0.0,"attr_effect":700,"skill_icon":"s_telankesi_s1","cd":3,"rate":100,"skill_story":"Kĩ năng trước khi bị đánh: Gây ra effect% ST ma pháp và 400% ST thuộc tính Hỏa. Nhận 2 tầng \"Hộ Giá\", duy trì 3 lượt. \nHộ Giá: Tiêu trừ 1 lần ST trực tiếp (ST truy kích, ST 4 thuộc tính, Diệt Ngay không thể dùng Hộ Giá để chặn);\nHiệu quả bị động:\n1: Càng chiến càng mạnh: Khi bản thân còn sống trên chiến trường, trước lượt đấu Broli sẽ nhận được hiệu quả Trói Buộc, cấm mục tiêu sử dụng Kĩ năng trước khi bị đánh 1 lượt.\n2: Ngộ phú đấu năng: Khi bản thân còn trên chiến trường, trước khi chiến đấu Goku mới sẽ nhận được hiệu quả Trói Buộc, cấm mục tiêu sử dụng Kĩ năng trước khi bị đánh 1 lượt.\n3. Thầy bạn như tri kỉ: Khi bản thân còn trên chiến trường, Kĩ năng trước khi bị đánh của Songohan sẽ gây ra thêm gấp 8 lần ST và hiệu quả \"Ổn Định\"\n4: Thanh kiếm Hi Vọng: Khi Broli/ Songoku/ Songohan còn trên chiến trường, kĩ năng trước khi chiến đấu của Trunks sẽ khiến mục tiêu mất 1 lần sổ lần max có thể kích hoạt kĩ năng trước khi bị đánh.\n5: Trái tim Saiya: Khi 4 người cùng tồn tại trên chiến trường, lần Hồi Sinh đầu tiên không bị trừ vào số lần hồi sinh.","effect_lvchange":3.0,"is_learn":0,"sprite_py":"telankesi_s1","skill_name":"Gánh Lên - Giai 4","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":800,"evo_story":"Yêu cầu: Tiến hóa +26","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":75014,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"76720":{"effect_talent":0.0,"attr_effect":200,"skill_icon":"s_mlads2_s2","cd":0,"rate":50,"skill_story":"Kĩ năng cảm tri: Trước khi bị kẻ địch tấn công, nhận 1 lần \"Gợi Đòn\"; hồi 30% HP max. Ngưng tụ 1 tầng \"Sức Mạnh Ma Thần\".","effect_lvchange":2.0,"is_learn":0,"sprite_py":"mlads2_s2","skill_name":"M