k_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"7706000":{"effect_talent":0.0,"attr_effect":1200,"skill_icon":"s_vegettopf_s6","cd":0,"rate":100,"skill_story":"Kĩ năng Tử Vong: Khi Hồi Sinh sẽ có tăng tỉ lệ không tốn số lần Hồi Sinh dựa theo số người cùng phe Ngọc Rồng có trên trường đấu, mỗi 1 người tăng 10% (Hiệu ứng Skin: Không cần có đồng đội cùng phe Ngọc Rồng trên trận, có tỉ lệ 40% được Hồi Sinh không tốn số lượt, sau khi Chuyển Sinh tăng lên 60%); Hồi toàn bộ HP bản thân (bỏ qua Trọng Thương). Gây ra ST thật bằng effect% tấn công ma pháp và 1500% ST thuộc tính Hoả cho toàn phe địch, tối đa Hồi Sinh 3 lần. Diệt Ngay ngẫu nhiên 1 mục tiêu phe địch.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"vegetto_s6","skill_name":"Nguyên tử bộc phát","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"","skill_type":"KDEAD","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"76611":{"effect_talent":0.0,"attr_effect":200,"skill_icon":"s_mlads_s1","cd":3,"rate":100,"skill_story":"Gây ra effect% ST ma pháp và 200% ST thuộc tính Địa cho toàn phe địch. Ngưng tụ 1 tầng \"Sức Mạnh Ma Thần\".","effect_lvchange":2.0,"is_learn":0,"sprite_py":"mlads_s1","skill_name":"Phản Đòn - Giai 2","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":5,"effect":600,"evo_story":"Điều kiện tiến cấp: Đồng đội tiến cấp đến +7","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":76612,"resource_count":0,"evo_food":30000,"action":0,"resource_type":0},"533400":{"effect_talent":0.0,"attr_effect":230,"skill_icon":"s_lingnengzhiren","cd":0,"rate":100,"skill_story":"Kĩ năng trước khi bị đánh:\nGây ra effect% ST ma pháp và 450% ST thuộc tính Thổ cho toàn phe địch, tăng 1tr điểm tấn công thuộc tính Thổ của bản thân; tăng 1tr điểm Phòng Ngự toàn thuộc tính; mỗi lượt tối đa khởi động 3 lần. Nếu mục tiêu có Beerus thì không phóng ra được kĩ năng này.","effect_lvchange":4.