{"1":{"text_id":1,"sort":1,"des":"%s khiêu chiến %s thành công, được %s Điểm Huyết Tinh"},"2":{"text_id":2,"sort":1,"des":"%s khiêu chiến %s thất bại, được %s Điểm Huyết Tinh"},"3":{"text_id":3,"sort":1,"des":"%s phòng thủ %s thành công, được %s Điểm Huyết Tinh"},"4":{"text_id":4,"sort":1,"des":"%s phòng thủ %s thất bại, được %s Điểm Huyết Tinh"},"5":{"text_id":5,"sort":2,"des":"%s gặp phải Loạn Lưu khi Thám Hiểm Vận Mệnh, không thể di động 1 ngày"},"6":{"text_id":6,"sort":2,"des":"%s gặp phải Đạo Tặc Không Thời Gian khi Thám Hiểm Vận Mệnh và chiến thắng họ nhận phần thưởng lớn!"},"7":{"text_id":7,"sort":2,"des":"%s gặp phải Đồng Hồ Ngược Thời Gian  khi Thám Hiểm Vận Mệnh, tất cả thưởng bị Loki thu hết lại, uổng công vui một trận!"},"8":{"text_id":8,"sort":2,"des":"%s mở ra Rương Thần Bí  khi Thám Hiểm Vận Mệnh, nhận được Thưởng Kinh Hỉ!"},"9":{"text_id":9,"sort":2,"des":"%s gặp phải Lãnh Chúa Tinh Tế  khi Thám Hiểm Vận Mệnh, thông qua khiêu chiến của Lãnh Chúa và nhận được Thưởng Đặc Biệt!"},"10":{"text_id":10,"sort":3,"des":"Anh Hùng thân mến, tuyên chiến Công Hội của ngài bị %s Công Hội thay được, hãy mau chóng điều chỉnh chiến lược, lấy lại Thành Trì!"},"11":{"text_id":11,"sort":3,"des":"Anh Hùng thân mến, khiêu chiến vị trí tài nguyên của ngài bị %s của Liên Minh %s thay thế, hãy mau chóng điều chỉnh chiến lược!"},"12":{"text_id":12,"sort":3,"des":"Trải qua một trận chiến nguy hiểm, Liên Minh %s chiến thắng Liên Minh %s, nhận được Thành Trì này và tất cả thành viên nhận được 100 Điểm Huyết Tinh, toàn bộ thành viên phe chiến bại nhận 50 Điểm Huyết Tinh"},"13":{"text_id":13,"sort":3,"des":""},"14":{"text_id":14,"sort":3,"des":""},"15":{"text_id":15,"sort":3,"des":""},"16":{"text_id":16,"sort":3,"des":"Công Hội %s hôm qua Tuyên Chiến tấn công thành công quân phòng thủ của Thành %s, rất mong chờ Liên Minh của ngài sẽ trở thành Chúa Tể siêu cấp~"},"17":{"text_id":17,"sort":3,"des":"Công Hội %s hôm qua Tuyên Chiến tấn công thất bại trước  quân phòng thủ của Thành %s, hãy tiếp tục rèn luyện và quay lại nhé! Hãy cẩn thận, thắng lợi nhờ tấn công, nhưng Quán Quân nhờ phòng thủ!"},"18":{"text_id":18,"sort":4,"des":"Mai là Ngày Thu Hoạch, tất cả thuế thu từ Chiếm Lĩnh TP, vị trí Tài Nguyên, Thám Hiểm đều đuoặc tăng gấp đôi~"},"19":{"text_id":19,"sort":4,"des":"Ngày Thu Hoạch tới rồi, mở shop hạn giờ Ngày Thu Hoạch tại Bách Hóa Bạo Đồ! Ngày Thu Hoạch không thể phát động Thành Chiến và Tài Nguyên Chiến, nhưng Thám Hiểm vẫn được nha~"},"20":{"text_id":20,"sort":4,"des":"Bắt đầu giai đoạn Tuyên Chiến, mau đến Chiến Trường chiến đấu thôi!"},"21":{"text_id":21,"sort":4,"des":"Bắt đầu giai đoạn Dàn Trận, xin tất cả Anh Hùng chú ý đi đến TP giao chiến để sắp xếp đội ngũ!"},"22":{"text_id":22,"sort":4,"des":"TP cấp 3 đứng đầu bị chiếm lĩnh, có thể đến Vùng Đất Kỳ Ngộ cao cấp và Vùng Tài Nguyên Thám Hiểm~"},"23":{"text_id":23,"sort":4,"des":"Liên Minh của ngài đã thành công chiếm lĩnh TP cấp 2, có thể đến Vùng Đất Kỳ Ngộ cao cấp và Vùng Tài Nguyên Thám Hiểm~"},"24":{"text_id":24,"sort":4,"des":"%s của Liên Minh %s chiến thắng phe địch, đạt được thắng lợi và %s Điểm Huyết Tinh, %s của Liên Minh %s bị đánh bại, nhận được 50 Điểm Huyết Tinh"},"25":{"text_id":25,"sort":4,"des":"Liên Minh %s Tuyên Chiến Thành %s của Liên Minh ngài, hãy sắp xếp phòng thủ ở vùng giao chiến~"},"26":{"text_id":26,"sort":4,"des":""},"27":{"text_id":27,"sort":5,"des":"Chiến Trường kì này đã kết thúc, Công Hội của bạn nhận được %s điểm, dưới đây là thưởng điểm Công Hội của bạn, xin hãy nhận~"},"28":{"text_id":28,"sort":5,"des":"Chiến Trường kì này đã kết thúc, bạn đã thể hiện rất xuất sắc trên Chiến Trường, dùng %s Điểm Huyết Tinh để XH thứ %s, dưới đây là thưởng Huyết Tinh cá nhân, xin hãy nhận~"},"29":{"text_id":29,"sort":2,"des":"%s gặp phải Đạo Tặc Không Thời Gian trong lúc Thám Hiểm Vận Mệnh, thất bại sau một trận khổ chiến, hãy tiếp tục cố gắng!"},"30":{"text_id":30,"sort":2,"des":"%s gặp phải Lãnh Chúa Tinh Tế trong lúc Thám Hiểm Vận Mệnh, không thông qua được khiêu chiến của Lãnh Chúa, hãy tiếp tục cố gắng!"},"31":{"text_id":31,"sort":6,"des":"Rất tiếc, bạn đã gặp phải Loạn Lưu trong lúc Thám Hiểm Vận Mệnh, 1 ngày không được di chuyển"},"32":{"text_id":32,"sort":6,"des":"Bạn gặp phải Đạo Tặc Không Thời Gian trong lúc Thám Hiểm Vận Mệnh, dành được  thắng lợi sau một trận chiến hung hiểm, đây là phần thưởng của bạn~"},"33":{"text_id":33,"sort":6,"des":"Bạn gặp phải Đồng Hồ Ngược Thời Gian  khi Thám Hiểm Vận Mệnh, tất cả thưởng bị Loki thu hết lại, uổng công vui một trận!"},"34":{"text_id":34,"sort":6,"des":"Bạn mở ra Rương Thần Bí  khi Thám Hiểm Vận Mệnh, nhận được phần thưởng sau!"},"35":{"text_id":35,"sort":6,"des":"Bạn gặp phải Lãnh Chúa Tinh Tế  khi Thám Hiểm Vận Mệnh, thông qua khiêu chiến của Lãnh Chúa và nhận được thưởng  của ngài!"},"36":{"text_id":36,"sort":6,"des":"Bạn gặp phải Đạo Tặc Không Thời Gian trong lúc Thám Hiểm Vận Mệnh, thất bại sau một trận khổ chiến, hãy tiếp tục cố gắng!"},"37":{"text_id":37,"sort":6,"des":"Bạn gặp phải Lãnh Chúa Tinh Tế trong lúc Thám Hiểm Vận Mệnh, không thông qua được khiêu chiến của Lãnh Chúa, hãy tiếp tục cố gắng!"},"38":{"text_id":38,"sort":7,"des":"Sau một trận chiến giành tài nguyên quyết liệt, %s đã giành chiến thắng cuối cùng, chiếm lĩnh vị trí tài nguyên Thần Thạch và nhận được 100 Điểm Huyết Tinh, trong khi %s sau khi thất bại đã nhận được 50 Điểm Huyết Tinh."},"39":{"text_id":39,"sort":7,"des":"Sau một trận chiến giành tài nguyên quyết liệt, %s đã giành chiến thắng cuối cùng, chiếm lĩnh vị trí tài nguyên Thánh Thạch và nhận được 100 Điểm Huyết Tinh, trong khi %s sau khi thất bại đã nhận được 50 Điểm Huyết Tinh."},"40":{"text_id":40,"sort":7,"des":"Sau một trận chiến giành tài nguyên quyết liệt, %s đã giành chiến thắng cuối cùng, chiếm lĩnh vị trí tài nguyên Hồn Thạch và nhận được 100 Điểm Huyết Tinh, trong khi %s sau khi thất bại đã nhận được 50 Điểm Huyết Tinh."},"41":{"text_id":41,"sort":7,"des":""},"42":{"text_id":42,"sort":7,"des":""},"43":{"text_id":43,"sort":7,"des":""},"44":{"text_id":44,"sort":7,"des":""},"45":{"text_id":45,"sort":7,"des":""},"46":{"text_id":46,"sort":7,"des":""},"47":{"text_id":47,"sort":7,"des":""},"48":{"text_id":48,"sort":7,"des":""},"49":{"text_id":49,"sort":7,"des":""},"50":{"text_id":50,"sort":8,"des":"Anh Hùng thân mến, Liên Minh của ngài được mời tham gia Chiến Trường Aether kì này, địa điểm chiến đấu của ngài tại Di Tích số %s, rất mong chờ biểu hiện của ngài!"},"51":{"text_id":51,"sort":9,"des":"Người chơi %s của Liên Minh %s bị hơn 100%% Ô Nhiễm Aether, không thể tiếp tục chiến đấu"},"52":{"text_id":52,"sort":9,"des":"Anh Hùng thân mến, Công Hội của ngài đã chiếm lĩnh Thành %s, đây là lợi tức từ thành phố này, xin hãy nhận~"},"53":{"text_id":53,"sort":9,"des":"Anh Hùng thân mến, Công Hội của ngài đã chiếm lĩnh điểm tài nguyên Cứ Điểm %s, đây là lợi tức từ tài nguyên này, xin hãy nhận~"},"54":{"text_id":54,"sort":9,"des":"Liên Minh %s thân mến, đây là thuế điểm KHKT của điểm tài nguyên %s mà quý Liên Minh có, tổng cộng %s điểm"},"56":{"text_id":56,"sort":9,"des":"Bạn gặp phải Đạo Tặc Không Thời Gian trong lúc Thám Hiểm Vận Mệnh, xin hãy kiểm tra kết quả chiến đấu của bạn!"},"57":{"text_id":57,"sort":9,"des":"Bạn gặp phải Lãnh Chúa Tinh Tế trong lúc Thám Hiểm Vận Mệnh, xin hãy kiểm tra kết quả chiến đấu của bạn!"},"60":{"text_id":60,"sort":9,"des":"%s gặp phải Đạo Tặc Không Thời Gian trong lúc Thám Hiểm Vận Mệnh, thất bại sau một trận khổ chiến, hãy tiếp tục cố gắng!"},"61":{"text_id":61,"sort":9,"des":"%s gặp phải Lãnh Chúa Tinh Tế trong lúc Thám Hiểm Vận Mệnh, không thông qua khiêu chiến của Lãnh Chúa, hãy tiếp tục cố gắng!"}}