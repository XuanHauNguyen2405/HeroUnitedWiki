":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":600,"evo_story":"Có thể dùng Xu mở khóa kỹ năng này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"26660":{"effect_talent":0.0,"attr_effect":900,"skill_icon":"s_weigongshilang_s6","cd":1,"rate":100,"skill_story":"Skill trước hiệp: Tất cả tấn công thuộc tính chuyển thành Vật Công, tạo lên 3~5 kẻ địch bất kì effect% ST Vật Lý và 900% ST thực thuộc tính Đất, trong hiệp này giảm 100% tấn công thuộc tính Đất, Phòng Ngự và Né của phe địch (ST sinh hiệu quả trong lần tấn công này), tạo thêm x4-6 ST và ST thuộc tính.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"weigongshilang_s6","skill_name":"Hoại Ảo Khí","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":800,"evo_story":"","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"26670":{"effect_talent":0.0,"attr_effect":800,"skill_icon":"s_weigongshilang_s7","cd":99,"rate":100,"skill_story":"Skill trước trận: Tạo lên toàn thể phe địch effect% ST Vật Lý và 800% ST thực thuộc tính Đất, vĩnh viễn tăng effect% tấn công thuộc tính Đất của bản thân, vĩnh viễn tăng 200% Trúng, Né và Bạo Kích, tạo x4-6 ST và ST thuộc tính, tăng 100% giới hạn HP của bản thân.","effect_lvchange":0.0,"is_learn":0,"sprite_py":"weigongshilang_s7","skill_name":"Vô Hạn Kiếm Chế","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":500,"evo_story":"","skill_type":"KBEFOREBATTLE","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"534200":{"effect_talent":0.0,"attr_effect":280,"skill_icon":"s_kuangyezhifeng","cd":99,"rate":100,"skill_story":"Kĩ năng trước chiến đấu:\nTăng 79% Giảm Thương chỉnh thể, vĩnh viễn tăng effect% tấn công ma pháp, tất cả Phòng Ngự và Né Tránh, gây ra 800% ST ma pháp và 900% ST thực thuộc tính Phong. Nếu mục tiêu không có \"Albedo\" hoặc \"Shall