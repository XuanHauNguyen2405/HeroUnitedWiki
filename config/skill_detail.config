 hóa tấn công t.tính Đất thành tấn công t.tính Lửa, tạo effect% ST Ma Công và ST thực bằng 800% ST t.tính Lửa lên toàn thể phe địch. Khiến mục tiêu hôn mê 1 hiệp. Nếu HP mục tiêu thấp hơn bản thân, sẽ tạo thêm X3 sát thương","effect_lvchange":10.0,"is_learn":0,"sprite_py":"Thanos_s4","skill_name":"Đả Kích Ngai Vàng Nổi","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":500,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"24050":{"effect_talent":0.0,"attr_effect":900,"skill_icon":"s_Thanos_s5","cd":2,"rate":100,"skill_story":"Dùng lực vũ trụ của găng tay Infinity tấn công toàn thể địch, tạo effect% ST Ma Công và 900% ST t.tính Đất, bỏ qua phòng ngự. Tạo thêm X4 sát thương lên kẻ địch có HP ít nhất và kẻ địch có HP nhiều nhất.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"Thanos_s5","skill_name":"Đả Kích Hành Tinh","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":600,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"24060":{"effect_talent":0.0,"attr_effect":950,"skill_icon":"s_Thanos_s6","cd":1,"rate":100,"skill_story":"Skill trước hiệp: Dùng năng lượng nguyên thủy của vũ trụ chuyển hóa tất cả tấn công thành Ma Công, tạo ST thực bằng effect% ST Ma Công lên toàn thể mục tiêu, hồi tất cả HP đã mất. Nếu HP của bản thân đã đầy, thì lần này sẽ hồi tương đương 50% lượng HP đồng đội đã mất.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"Thanos_s6","skill_name":"Nguyên Lực Đá Quý","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":500,"evo_story":"","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"24070":{"effect_talent":0.0,"attr_effect":600,"skill_icon":"s_Thanos_s7","cd":99,"rate":100,"skill_story":"Skill trước trận: Cả vũ trụ đều bó tay với Thanos, vì ông đã có-Găng Tay Infinity! Trang bị găng tay Infinity, tăng vĩnh viễn 800% phòng ngự tổng thể cho bản thân, tăng vĩnh viễn 100% Trúng, Né và Bạo Kích.","effect_lvchange":0.0,"is_learn":0,"sprite_py":"Thanos_s7","skill_name":"Đá Infinity","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":600,"evo_story":"","skill_type":"KBEFOREBATTLE","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"24110":{"effect_talent":0.0,"attr_effect":500,"skill_icon":"s_buzhihuowu_s1","cd":4,"rate":50,"skill_story":"Ném 2 cây quạt rực lửa tạo effect% ST Ma Công & 500% ST t.tính Lửa lên 1 dãy địch mặc định, mục tiêu mặc định chịu thêm X2 sát thương. 50% tỉ lệ khiến kẻ địch cháy, mỗi hiệp tạo sát thương bằng X3 tấn công t.tính Lửa, kéo dài 2 hiệp. Nếu mục tiêu đã cháy, sẽ tạo thêm X2 sát thương.","effect_lvchange":2.0,"is_learn":0,"sprite_py":"buzhihuowu_s1","skill_name":"Quạt Bướm Hoa","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":250,"evo_story":"","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":24111,"resource_count":0,"evo_food":5000,"action":0,"resource_type":0},"24111":{"effect_talent":0.0,"attr_effect":550,"skill_icon":"s_buzhihuowu_s1","cd":4,"rate":100,"skill_story":"Ném 2 cây quạt rực lửa tạo effect% ST Ma Công & 550% ST t.tính Lửa lên 1 dãy địch mặc định, mục tiêu mặc định chịu thêm X2 sát thương. 50% tỉ lệ khiến kẻ địch cháy, mỗi hiệp tạo sát thương bằng X3 tấn công t.tính Lửa, kéo dài 2 hiệp. Nếu mục tiêu đã cháy, sẽ tạo thêm X2 sát thương.","effect_lvchange":2.0,"is_learn":0,"sprite_py":"buzhihuowu_s1","skill_name":"Quạt Bướm Hoa.Cấp 2","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":5,"effect":300,"evo_story":"Yêu cầu: Tiến hóa +9","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":24112,"resource_count":0,"evo_food":30000,"action":0,"resource_type":0},"24112":{"effect_talent":0.0,"attr_effect":600,"skill_icon":"s_buz