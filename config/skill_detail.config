e":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"21960":{"effect_talent":0.0,"attr_effect":800,"skill_icon":"s_ssw_hurt","cd":1,"rate":100,"skill_story":"KN trước hiệp: Tấn công 1 mục tiêu, căn cứ trạng thái mục tiêu chọn KN để thả, hồi 50% HP đã mất của mình\nNếu mục tiêu không tồn tại trạng thái Vô Địch, sẽ thả \"Thiết Nha Đỏ\", bỏ qua trạng thái Vô Địch, tạo dmg thực bằng effect% Vật Công, không tạo dmg thuộc tính;\nNếu mục tiêu không tồn tại trạng thái Vô Địch, HP dưới 30%, sẽ thả \"Tàn Nguyệt Phá\", kết liễu mục tiêu;\nNếu mục tiêu không tồn tại trạng thái Vô Địch, HP trên 30%, Vật & Ma Công cao hơn bản thân, sẽ thả \"Thiết Nha Rồng\", tạo effect% dmg Ma Pháp & 800% dmg t.tính Gió, và hút 80% Vật & Ma Công của mục tiêu (Giảm mục tiêu địch, tăng thuộc tính bản thân), lần đánh sau có hiệu lực, 1 hiệp;\nNếu mục tiêu không tồn tại 3 trạng thái trên, sẽ thả \"Kim Cang Giáo\", tấn công toàn thể địch, tạo effect% dmg Vật Lý & 800% dmg t.tính Gió, làm choáng 1 mục tiêu, có hiệu lực 1 hiệp.","effect_lvchange":0.0,"is_learn":0,"sprite_py":"Inuyasha_s6","skill_name":"Thiết Toái Nha","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":650,"evo_story":"","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"21970":{"effect_talent":0.0,"attr_effect":600,"skill_icon":"s_ssw_cure","cd":99,"rate":100,"skill_story":"KN trước khi bị đánh: Tăng 50% Chính Xác và tỉ lệ Bạo Kích cho đồng đội","effect_lvchange":0.0,"is_learn":0,"sprite_py":"Inuyasha_s7","skill_name":"Khuyển Yêu","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":100,"evo_story":"","skill_type":"KBEATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"9124":{"effect_talent":20.0,"attr_effect":210,"skill_icon":"s_ad_guangjian","cd":2,"rate":100,"skill_story":"Tạo effect% sát thương ma pháp lên toàn b