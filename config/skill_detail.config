":0,"sprite_py":"Natsu_s2_1","skill_name":"Hỏa Long Trảo.Cấp 4","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":300,"evo_story":"Yêu cầu: Tiến hóa +29","skill_type":"KBEFOREHERT","attack_effect":"","is_evolution":21224,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"29036":{"effect_talent":0.0,"attr_effect":800,"skill_icon":"s_anying_s3","cd":2,"rate":100,"skill_story":"Kĩ năng phản kích: Đối toàn thể phe địch gây ra effect% ST ma pháp + 900% ST thuộc tính Phong. Dưới tác dụng của \"Hình thái Shadow\", truy kích thêm ST bằng 50% HP tối đa.","effect_lvchange":8.0,"is_learn":0,"sprite_py":"anying_s3","skill_name":"Phản Trảm - giai 7","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1100,"evo_story":"Điều kiện tiến cấp: Đồng đội tiến cấp đến +45","skill_type":"KBEFOREHERT","attack_effect":"","is_evolution":29037,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"29037":{"effect_talent":0.0,"attr_effect":900,"skill_icon":"s_anying_s3","cd":2,"rate":100,"skill_story":"Kĩ năng phản kích: Đối toàn thể phe địch gây ra effect% ST ma pháp + 900% ST thuộc tính Phong. Dưới tác dụng của \"Hình thái Shadow\", truy kích thêm ST bằng 50% HP tối đa. Gây ra effect% ST ma pháp và 900% ST thuộc tính Hỏa. Mục tiêu mỗi có 1 tầng \"Tách\" thì truy kích thêm ST bằng 10% HP tối đa.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"anying_s3","skill_name":"Phản Trảm - giai 8","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1200,"evo_story":"Điều kiện tiến cấp: Đồng đội tiến cấp đến +60","skill_type":"KBEFOREHERT","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"29040":{"effect_talent":0.0,"attr_effect":1200,"skill_icon":"s_anying_s4","cd":2,"rate":100,"skill_story":"Khống chế ma lực lưu động tạo thành cộng chấn, đối toàn thể phe địch gây ra effect% ST ma pháp thực và 1200% ST thực thuộc tính Phong. Dưới tác dụng của \"Hình thái Shadow\", xóa bỏ ngẫu nhiên lượt Hồi Sinh của 1 người, số lượt Hồi Sinh bị xóa bằng số lượt Hồi Sinh bản thân đã dùng (tối đa 4 lần), và Diệt Ngay đối phương.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"anying_s4","skill_name":"Ma Lực Rung Động","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"Tiêu Xu sẽ mở skill này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"61810":{"effect_talent":0.0,"attr_effect":160,"skill_icon":"s_ssw_hurt","cd":3,"rate":50,"skill_story":"Tạo effect% sát thương ma pháp lên toàn thể địch, mặc định làm choáng mục tiêu 1 hiệp và 30% tỉ lệ làm choáng đơn bị địch khác trong 1 hiệp. Thêm 160% sát thương thuộc tính Gió của bản thân","effect_lvchange":2.0,"is_learn":0,"sprite_py":"shashengwan_s1_1","skill_name":"Thanh Long Phá-Thánh","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":180,"evo_story":"","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":61811,"resource_count":0,"evo_food":5000,"action":0,"resource_type":0},"61811":{"effect_talent":0.0,"attr_effect":160,"skill_icon":"s_ssw_hurt","cd":3,"rate":100,"skill_story":"Tạo effect% sát thương ma pháp lên toàn thể địch, mặc định làm choáng mục tiêu 1 hiệp và 30% tỉ lệ làm choáng đơn bị địch khác trong 1 hiệp. Thêm 160% sát thương thuộc tính Gió của bản thân","effect_lvchange":2.0,"is_learn":0,"sprite_py":"shashengwan_s1_2","skill_name":"Thanh Long Phá-Thánh.Cấp 2","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":5,"effect":210,"evo_story":"Yêu cầu: Tiến hóa +9","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":61812,"resource_count":0,"evo_food":30000,"action":0,"resource_type":0},"61812":{"effect_talent":0.0,"attr_effect":160,"skill_icon":"s_ssw_hurt","cd":3,"rate":100,"skill_story":"Tạo effect% sát thương ma pháp lên toàn thể địch, mặc định làm choáng mục tiêu 1 hiệp và 30% tỉ lệ làm choáng đơn bị địch khác trong 1 hiệp. Thêm 160% sát thương thuộ