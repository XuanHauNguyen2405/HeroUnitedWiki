hần Kỵ Sĩ Đạo, không chỉ từ chối tấn công phái nữ, còn có 99% tỉ lệ hồi HP bản thân bằng 50% ST tấn công của tất cả tướng nữ; Khi thả skill này ở hiệp lẻ, sẽ nhận được 1 lần cơ hội hồi sinh (Hiệp chẵn không hồi sinh, hiệp trước trận là hiệp lẻ, buff hồi sinh mỗi hiệp chỉ phát động 1 lần), hồi sinh xong hồi 50% HP cho bản thân.","effect_lvchange":1.0,"is_learn":0,"sprite_py":"Sanji_s4","skill_name":"Kỵ Sĩ Đạo-Thánh","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":24,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"64750":{"effect_talent":0.0,"attr_effect":1200,"skill_icon":"s_Sanji_gpt","cd":2,"rate":100,"skill_story":"Tấn công tất cả tướng nam phe địch, tạo effect% ST vật lý và 800% ST t.tính Lửa; khiến 1 mục tiêu bị chấn động 2 hiệp và rơi vào trạng thái Cháy, ST cháy X2 ST t.tính Lửa, kéo dài 2 hiệp; Nếu phe địch có Zoro, sẽ tạo thêm 50% sát thương lên Zoro.","effect_lvchange":3.0,"is_learn":0,"sprite_py":"Sanji_s5","skill_name":"Quang Phổ Thích-Thánh","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1200,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"64760":{"effect_talent":0.0,"attr_effect":500,"skill_icon":"s_Sanji_hhsz","cd":1,"rate":100,"skill_story":"Skill trước hiệp: Quan sát kỹ tướng nữ trên trận, cứ có 1 tướng nữ, đều khiến Sanji tăng 50% Vật Công và 200% Tốc Độ, nếu đồng đội ra trận có Luffy, sẽ tăng 80% Vật Công của Luffy.","effect_lvchange":0.0,"is_learn":0,"sprite_py":"Sanji_s6","skill_name":"Sứ Giả Hộ Hoa-Thánh","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":60,"evo_story":"","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"64770":{"effect_talent":0.0,"attr_effect":550,"skill_icon":"s_Sanji_dyhy","cd":0,"rate":100,"skill_story":"Skill bị đánh: Sau khi Sanji bị tấn công sẽ có 99% tỉ lệ phản đòn 1 lần, nếu mục tiêu tấn công mình là phái nam, sẽ tấn công mục tiêu đó; Nếu kẻ tấn công là phái nữ, sẽ tấn công 1 kẻ địch nam, tạo effect% ST vật lý và 600% ST t.tính Lửa (Mỗi hiệp tối đa phát động 2 lần).","effect_lvchange":0.0,"is_learn":0,"sprite_py":"Sanji_s7","skill_name":"Hồi Ức Địa Ngục-Thánh","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":720,"evo_story":"","skill_type":"KBEFOREHERT","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"218330":{"effect_talent":0.0,"attr_effect":500,"skill_icon":"s_jmy_injure","cd":3,"rate":100,"skill_story":"对全体目标造成effect%的物理伤害以及500%水属性伤害，本回合恢复自身20%血量，并对敌方前排造成灼烧，效果持续2回合","effect_lvchange":5.0,"is_learn":0,"sprite_py":"boss_jinmuyan_s3","skill_name":"鳞赫·利世","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":450,"evo_story":"解锁条件：伙伴进阶至+4","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"64810":{"effect_talent":0.0,"attr_effect":250,"skill_icon":"s_yiquanchaoren_ptq","cd":4,"rate":50,"skill_story":"Ngẫu nhiên tấn công 1 mục tiêu, tạo effect% ST vật lý lên mục tiêu, tạo thêm 250% ST t.tính Đất, nếu mục tiêu chưa chết, làm mục tiêu choáng 1 hiệp. Sau khi trị số phẫn nộ bạo phát: Tăng 50% ST và ảnh hưởng ST thuộc tính.","effect_lvchange":2.0,"is_learn":0,"sprite_py":"yiquanchaoren_s1","skill_name":"Đấm Thường-Thánh","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":240,"evo_story":"","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":64811,"resource_count":0,"evo_food":5000,"action":0,"resource_type":0},"64811":{"effect_talent":0.0,"attr_effect":300,"skill_icon":"s_yiquanchaoren_ptq","cd":4,"rate":100,"skill_story":"Ngẫu nhiên tấn công 1 mục tiêu, tạo effect% ST vật lý lên mục tiêu, tạo thêm 300% ST t.tính Đất, nếu mục tiêu chưa chết, làm mục