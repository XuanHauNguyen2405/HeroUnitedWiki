ng thuộc tính nước của bản thân.","effect_lvchange":5.0,"is_learn":1,"sprite_py":"professorX_s2_1","skill_name":"Bạo phá tinh thần","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":150,"evo_story":"Yêu cầu: Tiến hóa+2","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":3421,"resource_count":10000,"evo_food":5000,"action":3,"resource_type":3},"24570":{"effect_talent":0.0,"attr_effect":600,"skill_icon":"s_shalu_s7","cd":99,"rate":100,"skill_story":"Skill trước trận: Kết liễu kẻ dãy trước hàng bất kỳ, và có 20% tỉ lệ kết liễu kẻ địch dãy sau (Bỏ qua hiệu quả Vô Địch của phe địch, nhưng sẽ không kết liễu kẻ địch dãy sau nữa). Hấp thụ 30% Tốc Độ hiện tại của kẻ địch còn lại dẫn vào bản thân. Vĩnh viễn miễn dịch hiệu quả Đứng Im, Hóa Đá, Choáng, Hôn Mê, Hỗn Loạn, Chế Giễu, Tsukuyomi.","effect_lvchange":0.0,"is_learn":0,"sprite_py":"shalu_s7","skill_name":"Tia Tử Vong Toàn Công","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":200,"evo_story":"","skill_type":"KBEFOREBATTLE","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"90107":{"effect_talent":0.0,"attr_effect":160,"skill_icon":"s_JETluanda.png","cd":2,"rate":100,"skill_story":"Thân thủ mạnh mẽ, tạo effect% sát thương vật lí cho mục tiêu có tấn công cao nhất của phe địch, tuyệt đối chính xác! Nếu mục tiêu có tăng né tránh thì tăng thêm 30% sát thương. Tạo thêm 160% sát thương thuộc tính đất của bản thân.","effect_lvchange":5.0,"is_learn":1,"sprite_py":"gnorthfist_s1_1","skill_name":"Cực Đạo Bách Liệt Quyền","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":130,"evo_story":"","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":3711,"resource_count":10000,"evo_food":5000,"action":3,"resource_type":3},"90108":{"effect_talent":0.0,"attr_effect":160,"skill_icon":"s_qiushengbenneng.png","cd":3,"rate":100,"skill_story":"Tạo effect% sát thương vật lí cho mục tiêu có điểm HP còn lại thấp nhất của phe địch, 