con":"s_sishendaili.png","cd":99,"rate":100,"skill_story":"KN trước trận. Trong 2 hiệp -6% ST phải chịu của tất cả nhân vật phe ta, cứ tăng 1 LV kỹ năng, giảm thêm 0.8%.","effect_lvchange":80.0,"is_learn":1,"sprite_py":"ichigo_s1_1","skill_name":"Hồn.Hộ","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":600,"evo_story":"","skill_type":"KBEFOREBATTLE","attack_effect":"","is_evolution":0,"resource_count":10000,"evo_food":0,"action":3,"resource_type":3},"9450":{"effect_talent":0.0,"attr_effect":0,"skill_icon":"s_sdx_cure","cd":99,"rate":100,"skill_story":"Kỹ năng trước trận, làm mù 1 hiệp mục tiêu mặc định phe địch, và giảm 30% thuộc tính phòng ngự lên phe địch, 2 hiệp ","effect_lvchange":0.0,"is_learn":0,"sprite_py":"flash_s5","skill_name":"Sấm Chớp","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":30,"evo_story":"","skill_type":"KBEFOREBATTLE","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"42220":{"effect_talent":0.0,"attr_effect":100,"skill_icon":"s_yueyatianchong.png","cd":3,"rate":100,"skill_story":"Tạo effect% ST vật lý lên mục tiêu hàng thẳng, có 50% tỉ lệ bạo kích và làm kẻ địch Tụt Máu, mỗi hiệp -3% HP, nếu là trạng thái Vạn Giải, chắc chắn phát động.","effect_lvchange":5.0,"is_learn":1,"sprite_py":"ichigo_s2_1","skill_name":"Hồn.Sát","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":120,"evo_story":"","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":10000,"evo_food":0,"action":3,"resource_type":3},"42230":{"effect_talent":0.0,"attr_effect":100,"skill_icon":"s_wanjie.png","cd":4,"rate":100,"skill_story":"Thả sức mạnh cuối của Trảm Hồn Đao, nhận được Vạn Giải. Tạo effect% ST vật lý lên mục tiêu, +15% Tấn Công & Tốc Độ cho mình, 2 hiệp.","effect_lvchange":4.0,"is_learn":1,"sprite_py":"ichigo_s3_1","skill_name":"Hồn.Giải","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":130,"evo_story":"","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":10000,"evo_food":0,"action":3,"resource_type":3},"75010":{"effect_talent":0.0,"attr_effect":550,"skill_icon":"s_telankesi_s1","cd":3,"rate":50,"skill_story":"Kĩ năng trước khi bị đánh: Gây ra effect% ST ma pháp và 100% ST thuộc tính Hỏa. Nhận 2 tầng \"Hộ Giá\", duy trì 3 lượt. \nHộ Giá: Tiêu trừ 1 lần ST trực tiếp (ST truy kích, ST 4 thuộc tính, Diệt Ngay không thể dùng Hộ Giá để chặn);\nHiệu quả bị động:\n1: Càng chiến càng mạnh: Khi bản thân còn sống trên chiến trường, trước lượt đấu Broli sẽ nhận được hiệu quả Trói Buộc, cấm mục tiêu sử dụng Kĩ năng trước khi bị đánh 1 lượt.\n2: Ngộ phú đấu năng: Khi bản thân còn trên chiến trường, trước khi chiến đấu Goku mới sẽ nhận được hiệu quả Trói Buộc, cấm mục tiêu sử dụng Kĩ năng trước khi bị đánh 1 lượt.\n3. Thầy bạn như tri kỉ: Khi bản thân còn trên chiến trường, Kĩ năng trước khi bị đánh của Songohan sẽ gây ra thêm gấp 8 lần ST và hiệu quả \"Ổn Định\"\n4: Thanh kiếm Hi Vọng: Khi Broli/ Songoku/ Songohan còn trên chiến trường, kĩ năng trước khi chiến đấu của Trunks sẽ khiến mục tiêu mất 1 lần sổ lần max có thể kích hoạt kĩ năng trước khi bị đánh.\n5: Trái tim Saiya: Khi 4 người cùng tồn tại trên chiến trường, lần Hồi Sinh đầu tiên không bị trừ vào số lần hồi sinh.\n","effect_lvchange":2.0,"is_learn":0,"sprite_py":"telankesi_s1","skill_name":"Gánh Lên","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":500,"evo_story":"","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":75011,"resource_count":0,"evo_food":5000,"action":0,"resource_type":0},"75011":{"effect_talent":0.0,"attr_effect":600,"skill_icon":"s_telankesi_s1","cd":3,"rate":100,"skill_story":"Kĩ năng trước khi bị đánh: Gây ra effect% ST ma pháp và 200% ST thuộc tính Hỏa. Nhận 2 tầng \"Hộ Giá\", duy trì 3 lượt. \nHộ Giá: Tiêu trừ 1 lần ST trực tiếp (ST truy kích, ST 4 thuộc tính, Diệt Ngay không thể dùng Hộ Giá để chặn);\nHiệu quả bị động:\n1: Càng chiến càng mạnh: Khi bản thân cò