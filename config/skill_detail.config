hể phe địch gây ra effect% ST ma pháp + 900% ST thuộc tính Phong. Dưới tác dụng của \"Hình thái Shadow\", truy kích thêm ST bằng 50% HP tối đa. Gây ra effect% ST ma pháp và 900% ST thuộc tính Hỏa. Mục tiêu mỗi có 1 tầng \"Tách\" thì truy kích thêm ST bằng 10% HP tối đa.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"anying_s3","skill_name":"Phản Trảm - giai 8","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1200,"evo_story":"Yêu cầu: Tiến hóa +60","skill_type":"KBEFOREHERT","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"75440":{"effect_talent":0.0,"attr_effect":1200,"skill_icon":"s_anying_s4","cd":2,"rate":100,"skill_story":"Khống chế ma lực lưu động tạo thành cộng chấn, đối toàn thể phe địch gây ra effect% ST ma pháp thực và 1200% ST thực thuộc tính Phong. Dưới tác dụng của \"Hình thái Shadow\", xóa bỏ ngẫu nhiên lượt Hồi Sinh của 1 người, số lượt Hồi Sinh bị xóa bằng số lượt Hồi Sinh bản thân đã dùng (tối đa 4 lần), và Diệt Ngay đối phương.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"anying_s4","skill_name":"Ma Lực Rung Động","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"9910":{"effect_talent":0.0,"attr_effect":150,"skill_icon":"s_wukong_injure","cd":3,"rate":50,"skill_story":"Tạo effect% sát thương vật lí và 150% sát thương thuộc tính đất lên mục tiêu xếp sau bên địch, nhất định tạo 1.5 lần sát thương lên mục tiêu cấp thấp hơn mình","effect_lvchange":2.0,"is_learn":0,"sprite_py":"meihouwang_s1_1","skill_name":"Hoành Tảo Thiên Quân","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":150,"evo_story":"","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":9911,"resource_count":0,"evo_food":5000,"action":0,"resource_type":0},"9911":{"effect_talent":0.0,"attr_effect":160,"ski