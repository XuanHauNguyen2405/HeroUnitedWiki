gito trong trận, được Diệt Ngay thêm 1 kẻ địch; nhận hiệu ứng \"Ổn Định\".\nPhe Ngọc Rồng bao gồm: Cuồng - Broli/ Kakalot/Gohan Dã Thú/Kiếm Hy Vọng/Vegeta.(Hiệu ứng Skin: Thẻ Phe không nhận Bị Động nữa; bản thân nhận 2 tầng Gợi Đòn, lượng HP max được hồi phục lên tới 100%)","effect_lvchange":4.0,"is_learn":0,"sprite_py":"vegetto_s2","skill_name":"Phòng hộ năng lượng - Giai 5","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":900,"evo_story":"Điều kiện tiến cấp: Đồng đội tiến cấp đến +32","skill_type":"KBEATTACK","attack_effect":"","is_evolution":77025,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"77060":{"effect_talent":0.0,"attr_effect":1200,"skill_icon":"s_vegetto_s6","cd":0,"rate":100,"skill_story":"Kĩ năng Tử Vong: Khi Hồi Sinh sẽ có tăng tỉ lệ không tốn số lần Hồi Sinh dựa theo số người cùng phe Ngọc Rồng có trên trường đấu, mỗi 1 người tăng 10% (Hiệu ứng Skin: Không cần có đồng đội cùng phe Ngọc Rồng trên trận, có tỉ lệ 40% được Hồi Sinh không tốn số lượt, sau khi Chuyển Sinh tăng lên 60%); Hồi toàn bộ HP bản thân (bỏ qua Trọng Thương). Gây ra ST thật bằng effect% tấn công ma pháp và 1500% ST thuộc tính Hoả cho toàn phe địch, tối đa Hồi Sinh 3 lần. Diệt Ngay ngẫu nhiên 1 mục tiêu phe địch.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"vegetto_s6","skill_name":"Xóa Sổ","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"","skill_type":"KDEAD","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"77070":{"effect_talent":0.0,"attr_effect":1800,"skill_icon":"s_vegetto_s7","cd":99,"rate":100,"skill_story":"Kĩ năng trước khi chiến đấu: Phục hồi 100% HP max bản thân. Gây ra ST thực bằng effect% tấn công vật lý và 1800% ST thuộc tính Hỏa cho kẻ địch","effect_lvchange":10.0,"is_learn":0,"sprite_py":"vegetto_s7","skill_name":"Cực - Kiếm Khí","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"","skill_type":"KBEFOREBATTLE