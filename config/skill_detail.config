ax_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1100,"evo_story":"Yêu cầu: Tiến hóa+45","skill_type":"KBEFOREHERT","attack_effect":"","is_evolution":75537,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"75537":{"effect_talent":0.0,"attr_effect":850,"skill_icon":"s_anying2_s3","cd":2,"rate":100,"skill_story":"Kĩ năng phản kích: Gây ra effect% ST ma pháp và 900% ST thuộc tính Phong cho toàn phe địch. Ở \"Hình thái Shadow\", gây ra thêm ST bằng 50% HP max của mục tiêu. Gây ra effect% ST ma pháp và 900% ST thuộc tính Hỏa. Mục tiêu mỗi có 1 tầng \"Giải Tích\" thì gây ra thêm ST bằng 10% HP max của mục tiêu","effect_lvchange":10.0,"is_learn":0,"sprite_py":"anying2_s3","skill_name":"Chém Ngược - giai 8","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1200,"evo_story":"Yêu cầu: Tiến hóa +60","skill_type":"KBEFOREHERT","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"75540":{"effect_talent":0.0,"attr_effect":1800,"skill_icon":"s_anying2_s4","cd":2,"rate":100,"skill_story":"Khống chế dòng chảy ma lực gây ra cộng chấn, gây ra effect% ST ma pháp và 1200% ST thuộc tính Phong cho toàn phe địch. Giảm Phòng ngực toàn thuộc tính của mục tiêu về 0, duy trì 2 lượt","effect_lvchange":10.0,"is_learn":0,"sprite_py":"anying2_s4","skill_name":"Sóng Shadow","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"534300":{"effect_talent":0.0,"attr_effect":230,"skill_icon":"s_lingnengzhiren","cd":0,"rate":100,"skill_story":"Kĩ năng trước khi bị đánh:\nTăng 200% Né Tránh (có thể chồng 10 lần), gây ra ST truy kích bằng mốc ở lượt hiện tại. Mỗi lượt được kích hoạt 3 lần.","effect_lvchange":4.0,"is_learn":0,"sprite_py":"boss_caolubaqianliu_s1","skill_name":"Tế Điển","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1000,"evo_story":"","skill_type":"KBEATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"75550":{"effect_talent":0.0,"attr_effect":1800,"skill_icon":"s_anying2_s5","cd":1,"rate":100,"skill_story":"Kĩ năng trước lượt đấu: Dùng cực hạn thao tác để sử dụng ma lực, mô phỏng nổ hạt nhân. Gây ra effect% ST ma pháp và 1800% ST thuộc tính Phong cho toàn phe địch. Diệt Ngay 1 đơn vị ngẫu nhiên","effect_lvchange":10.0,"is_learn":0,"sprite_py":"anying2_s5","skill_name":"Atomic MAX","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"75560":{"effect_talent":0.0,"attr_effect":1500,"skill_icon":"s_anying2_s6","cd":0,"rate":100,"skill_story":"Kĩ năng tử vong: Hồi toàn bộ HP của bản thân (bỏ qua Trọng Thương). Gây ra effect% ST ma pháp và 1500% ST thuộc tính Phong cho toàn phe địch. Tối đa Hồi Sinh 3 lần. Có tỉ lệ 30% rút năng lượng HP để thêm 1 lần Hồi Sinh cho bản thân.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"anying2_s6","skill_name":"Ma Lực Đâm Xuyên","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"","skill_type":"KDEAD","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"531420":{"effect_talent":0.0,"attr_effect":800,"skill_icon":"boss_phscboss_skill2","cd":2,"rate":100,"skill_story":"Tấn công toàn bộ kẻ địch, gây ra 800% ST thuộc tính công thường cho mục tiêu, khiến ngẫu nhiên 1-3 mục tiêu giảm 20% - 90% Giảm Thương, và khiến các mục tiêu còn lại bị Hôn Mê. Khiến mục tiêu bị Hôn Mê.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"eliteboss3_s2","skill_name":"Trọng Kích Siêu Thứ Nguyên","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":800,"evo_story":"","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"75570":{"effect_talent":0.0,"attr_effect":1800,"skill_icon":"s_anying2_s7","cd":99,"rate":100,"skill_story":"Kĩ năng tiền chiến: Tăng vĩnh viễn 240% HP tối đa của bản thân, và 79% Giảm Thương chỉnh thể, tăng 500% Trúng Đích, Né Tránh và Bạo Kích. Phóng Thiên Thạch Ma Lực, gây ra ST thực gồm effect% ST ma pháp và 1800% ST thuộc tính Phong cho toàn phe địch","effect_lvchange":10.0,"is_learn":0,"sprite_py":"anying2_s7","skill_name":"Ám Đao","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"","skill_type":"KBEFOREBATTLE","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"72670":{"effect_talent":0.0,"attr_effect":0,"skill_icon":"s_Buluoli_s7","cd":99,"rate":100,"skill_story":"Kỹ năng trước lượt đấu: Tăng 180% HP/ 79% Giảm Thương, Trúng Đích và Né Tránh của bản thân, gây ra thêm ST thực bằng 50% HP .","effect_lvchange":10.0,"is_learn":0,"sprite_py":"Buluoli_s7","skill_name":"Giác Tỉnh","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"","skill_type":"KBEFOREBATTLE","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"42810":{"effect_talent":0.0,"attr_effect":100,"skill_icon":"s_xuezhihouyi.png","cd":1,"rate":100,"skill_story":"Khi thả tấn công thường, mỗi lần có thể chuyển 20% ST thành HP bản thân. Nếu rơi vào trạng thái Thức Tỉnh, có tỉ lệ kèm thêm 50% ST. LV kỹ năng càng cao, tỉ lệ kèm ST càng cao.","effect_lvchange":0.0,"is_learn":1,"sprite_py":"","skill_name":"Hậu Duệ Máu","max_lv":20,"pre_cd":0,"effect_delay":0,"skill_quality":3,"effect":0,"evo_story":"","skill_type":"KBEATTACK","attack_effect":"","is_evolution":0,"resource_count":10000,"evo_food":0,"action":3,"resource_type":3},"42820":{"effect_talent":0.0,"attr_effect":100,"skill_icon":"s_juexing.png","cd":1,"rate":100,"skill_story":"Khi chiến đấu HP thấp hơn 50%. Khi bị tấn công, có tỉ lệ rơi vào trạng thái Thức Tỉnh (Mỗi trận tối đa chỉ được rơi vào Thức Tỉnh 1 lần). Hồi HP đến mức tối đa, và +5% tất cả thuộc tính.","effect_lvchange":0.0,"is_learn":1,"sprite_py":"","skill_name":"Thức Tỉnh","max_lv":20,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":0,"evo_story":"","skill_type":"KBEATTACK","attack_effect":"","is_evolution":0,"resource_count":10000,"evo_food":0,"action":3,"resource_type":3},"42830":{"effect_talent":0.0,"attr_effect":100,"skill_icon":"s_xiewangyanshajian.png","cd":1,"rate":100,"skill_story":"Tạo 80% Ma Công 1 lần lên toàn thể địch, nếu ở trạng thái Thức Tỉnh, +20% ST.","effect_lvchange":0.0,"is_learn":1,"sprite_py":"","skill_name":"Thị Tộc Lực","max_lv":20,"pre_cd":0,"effect_delay":0,"skill_quality":3,"effect":0,"evo_story":"","skill_type":"KBEATTACK","attack_effect":"","is_evolution":0,"resource_count":10000,"evo_food":0,"action":3,"resource_type":3},"75610":{"effect_talent":0.0,"attr_effect":100,"skill_icon":"s_yileina_s1","cd":3,"rate":100,"skill_story":"Lực công của tất cả thuộc tính đều chuyển thành Lực công thuộc tính Thủy, gây ra effect% ST ma pháp và 100% ST thuộc tính Thủy cho toàn thể phe địch","effect_lvchange":2.0,"is_learn":0,"sprite_py":"yileina_s1","skill_name":"Băng Trùy Ma Pháp","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":500,"evo_story":"","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":75611,"resource_count":0,"evo_food":5000,"action":0,"resource_type":0},"75611":{"effect_talent":0.0,"attr_effect":200,"skill_icon":"s_yileina_s1","cd":3,"rate":100,"skill_story":"Lực công của tất cả thuộc tính đều chuyển thành Lực công thuộc tính Thủy, gây ra effect% ST ma pháp và 200% ST thuộc tính Thủy cho toàn thể phe địch","effect_lvchange":2.0,"is_learn":0,"sprite_py":"yileina_s1","skill_name":"Băng Trùy Ma Pháp - giai 2","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":5,"effect":600,"evo_story":"Yêu cầu: Tiến hóa +9","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution