现世和冥界之间，对敌方全体进行猛烈的斩击造成effect%的魔法伤害，并对生命值25%以下的敌人造成2倍伤害。额外造成450%的自身火属性伤害。","effect_lvchange":5.0,"is_learn":0,"sprite_py":"boss_hadisi_s2","skill_name":"幽魂斩","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":450,"evo_story":"解锁条件：伙伴进阶至+2","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"108517":{"effect_talent":0.0,"attr_effect":230,"skill_icon":"icon_maze_fire","cd":0,"rate":100,"skill_story":"Xông vào trận hình phe địch, tạo effect% ST vật lý và 230% ST t.tính Đất lên toàn thể địch.","effect_lvchange":280.0,"is_learn":0,"sprite_py":"boss_gailun_s1_8","skill_name":"Thẩm Phán","max_lv":7,"pre_cd":2,"effect_delay":0,"skill_quality":0,"effect":30,"evo_story":"Yêu cầu: Tiến hóa+50","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":3,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"75750":{"effect_talent":0.0,"attr_effect":1800,"skill_icon":"s_yileina2_s5","cd":1,"rate":100,"skill_story":"Kĩ năng trước lượt đấu: Phóng Ma Pháp Đóng Băng, Lực công của tất cả thuộc tính đều chuyển thành Lực công thuộc tính Thủy, gây ra ST thực gồm effect% ST ma pháp và 1800% ST thuộc tính Thủy cho toàn thể phe địch. Gây thêm 1 tầng \"Phong Ấn Băng\": Khi bị dẫn nổ sẽ giảm bớt 1 lần Hồi Sinh của mục tiêu.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"yileina2_s5","skill_name":"Lazer Áo Thuật","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"206830":{"effect_talent":0.0,"attr_effect":20,"skill_icon":"s_lingti.png","cd":1,"rate":100,"skill_story":"身为冥界之王，拥有众多的灵魂为其提供不死的力量，死亡后复活（每场战斗仅能使用一次），复活后生命上限减少30%，同时自身所有属性上升effect%，持续2回合，并减伤20%","effect_lvchange":1.0,"is_learn":0,"sprite_py":"boss_hadisi_s3","skill_name":"幽冥之王","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":35,