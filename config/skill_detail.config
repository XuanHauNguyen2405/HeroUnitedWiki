y, gây ra ST thực gồm effect% ST ma pháp và 1800% ST thuộc tính Thủy cho toàn thể phe địch. Gây thêm 1 tầng \"Phong Ấn Băng\": Khi bị dẫn nổ sẽ giảm bớt 1 lần Hồi Sinh của mục tiêu.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"yileina_s5","skill_name":"Tuyệt Đối Âm Độ","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"75660":{"effect_talent":0.0,"attr_effect":1200,"skill_icon":"s_yileina_s6","cd":0,"rate":100,"skill_story":"Kĩ năng Tử Vong: Hồi phục toàn bộ HP của bản thân (bỏ qua Trọng Thương). Gây ra effect% ST thực ma pháp cho toàn phe địch, tối đa Hồi Sinh 3 lần.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"yileina_s6","skill_name":"Bạo Phát Ma Pháp","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"","skill_type":"KDEAD","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"75670":{"effect_talent":0.0,"attr_effect":1800,"skill_icon":"s_yileina_s7","cd":99,"rate":100,"skill_story":"Kĩ năng trước chiến đấu: Áp súc ma pháp và tăng cường hiệu quả Chém Đứt, Lực công của tất cả thuộc tính đều chuyển thành Lực công thuộc tính Phong; Gây ra ST thực gồm effect% ST ma pháp và 1800% ST thuộc tính Phong cho toàn thể phe địch","effect_lvchange":10.0,"is_learn":0,"sprite_py":"yileina_s7","skill_name":"Chém Đứt Không Khí","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"","skill_type":"KBEFOREBATTLE","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"42910":{"effect_talent":0.0,"attr_effect":100,"skill_icon":"s_lingti.png","cd":1,"rate":100,"skill_story":"Khi bắt đầu mỗi hiệp đều có tỉ lệ nhất định hồi 5% HP.","effect_lvchange":0.0,"is_learn":1,"sprite_py":"","skill_name":"Tộc Bất Tử","max_lv":20,"pre_cd":0,"effect_delay":0