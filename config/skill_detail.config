iêu đó. Nếu tỉ lệ chuyển hóa của tấn công thuộc tính dưới 120%, sẽ tạo thêm gấp 1.5 ST lên mục tiêu đó","effect_lvchange":10.0,"is_learn":0,"sprite_py":"Minato_s4","skill_name":"Thuật Phân Thân Shuriken","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":600,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"23750":{"effect_talent":0.0,"attr_effect":900,"skill_icon":"s_Minato_s5","cd":2,"rate":100,"skill_story":"Tạo effect% ST vật lý và 900% ST t.tính Gió lên toàn thể địch. Và kèm ST bằng 50% HP lớn nhất. Tốc độ cực nhanh, sát thương bỏ qua phòng ngự của phe địch. Tạo thêm gấp 3 ST lên mục tiêu dãy sau. Nếu trên người kẻ địch có buff Tê hoặc Cháy, sẽ tạo thêm gấp 2 sát thương.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"Minato_s5","skill_name":"Luân Vũ Hống Xoắn Ốc","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":600,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"23760":{"effect_talent":0.0,"attr_effect":800,"skill_icon":"s_Minato_s6","cd":99,"rate":100,"skill_story":"Skill trước trận: Tăng vĩnh viễn 250% Chính Xác và Né cho bản thân, tăng 10000k Tốc Độ, tăng 600% Phòng Ngự và Phòng Ngự toàn t.tính. Khiến kẻ địch không thể bắt được bóng của mình, miễn dịch buff bất lợi vĩnh viễn: Đứng Im, Hôn Mê, Hóa Đá, Choáng, Hỗn Loạn, Chế Giễu, Giảm Tốc và Né.","effect_lvchange":0.0,"is_learn":0,"sprite_py":"Minato_s6","skill_name":"Thuấn Thân Thuật","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":100,"evo_story":"","skill_type":"KBEFOREBATTLE","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"23770":{"effect_talent":0.0,"attr_effect":600,"skill_icon":"s_Minato_s7","cd":99,"rate":100,"skill_story":"Skill tử trận: Tử trận xong hồi sinh, xóa tất cả buff trọng thương. Hồi tất cả HP, tăng 100% Tốc Độ và Né cho toàn thể đồng đội, mở khóa chế độ Cửu Vỹ, tăng vĩnh viễn 100% Vật & Ma Công, tăng 1000k-1800k Tấn Công t.tính Gió, kéo dài 3 hiệp. Cộng 1 tầng buff Vô Địch cho bản thân, miễn dịch 2 lần tấn công.","effect_lvchange":0.0,"is_learn":0,"sprite_py":"Minato_s7","skill_name":"Mode Cửu Vĩ","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":600,"evo_story":"","skill_type":"KDEAD","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"74960":{"effect_talent":0.0,"attr_effect":1500,"skill_icon":"s_peien2_s6","cd":0,"rate":100,"skill_story":"Kĩ năng tử vong: Thông qua Địa Ngục hồi sinh bản thân, hồi toàn bộ HP (bỏ qua Trọng Thương). Gây ra effect% ST thực ma pháp và 1500% ST thực thuộc tính Thổ, tối đa có thể Hồi Sinh 3 lần. Diệt Ngay 1 đơn vị ngẫu nhiên","effect_lvchange":10.0,"is_learn":0,"sprite_py":"peien2_s6","skill_name":"Diêm Vương Luân Hồi Phục Sinh","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"","skill_type":"KDEAD","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"9425":{"effect_talent":0.0,"attr_effect":210,"skill_icon":"s_sdx_injure","cd":2,"rate":100,"skill_story":"Phát tán phân tử trên cơ thể xuyên qua kẻ địch, tạo effect% sát thương vật lý cho toàn thể phe địch, tạo thêm 210% thuộc tính sát thương gió, và hồi phục 30% HP bản thân","effect_lvchange":4.0,"is_learn":0,"sprite_py":"flash_s2_1","skill_name":"Trảm Sát Cấp Tốc Cấp 6","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":320,"evo_story":"Yêu cầu: Tiến hóa+39","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":9426,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"23810":{"effect_talent":0.0,"attr_effect":500,"skill_icon":"s_gelimuqiao_s1","cd":0,"rate":50,"skill_story":"Skill phản đòn: Dùng Trảm Phách Đao·Báo tấn công kẻ địch, sau khi chịu tấn công sẽ có 