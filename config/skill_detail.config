ct_lvchange":5.0,"is_learn":0,"sprite_py":"telankesi2_s1","skill_name":"Lưỡi Kiếm - Giai 6","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1000,"evo_story":"Yêu cầu: Tiến hóa+37","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":75116,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"75116":{"effect_talent":0.0,"attr_effect":850,"skill_icon":"s_telankesi2_s1","cd":2,"rate":100,"skill_story":"Gây ra effect% ST ma pháp và 700% ST thuộc tính Hỏa cho toàn phe địch.","effect_lvchange":8.0,"is_learn":0,"sprite_py":"telankesi2_s1","skill_name":"Lưỡi Kiếm - Giai 7","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1100,"evo_story":"Yêu cầu: Tiến hóa+41","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":75117,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"75117":{"effect_talent":0.0,"attr_effect":900,"skill_icon":"s_telankesi2_s1","cd":2,"rate":100,"skill_story":"Gây ra effect% ST ma pháp và 800% ST thuộc tính Hỏa cho toàn phe địch.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"telankesi2_s1","skill_name":"Lưỡi Kiếm - Giai 8","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1200,"evo_story":"Yêu cầu: Tiến hóa +50","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"75120":{"effect_talent":0.0,"attr_effect":200,"skill_icon":"s_telankesi2_s2","cd":0,"rate":50,"skill_story":"Kĩ năng trước khi bị đánh: Gây ra effect% ST ma pháp và 100% ST thuộc tính Hỏa cho toàn phe địch.Nhận 2 tầng \"Hộ Giá\", duy trì 3 lượt.Hộ Giá: Chắn các ST trực tiếp từ địch 1 lần. (ST truy kích, ST 4 thuộc tính, Diệt Ngay, không thể dùng Hộ Giá chắn);\nHiệu quả bị động (không cần đeo kĩ năng này):\n1: Càng đánh càng mạnh: Khi bản thân còn trên chiến trường, trước khi bắt đầu lượt đấu Broli nhận buff Trói Buộc, cấm kĩ năng trước khi bị đánh của mục tiêu 1 lượt.\n2: Tăng chiến lực: Khi bản thân còn trên chiến trường, trước khi chiến đấu Songoku mới nhận hiệu quả Trói Buộc, cấm kĩ năng trước khi bị đánh của mục tiêu 1 lượt.\n3: Như thầy như bạn: Khi bản thân còn trên chiến trường, trước khi bị đánh Songohan nhận thêm 8 lần ST và hiệu quả \"Ổn Định\".\n4: Thanh Gươm Hy Vọng: Khi Broli/ Songoku/ Songohan còn trên chiến trường, kĩ năng trước khi chiến đấu của Trunks sẽ khiến mục tiêu mất 1 lượt giới hạn kĩ năng trước khi bị đánh.\n5: Trái tim Saiya: Khi 4 người đều còn trên chiến trường, lần Hồi Sinh đầu tiên không mất lượt Hồi Sinh.","effect_lvchange":2.0,"is_learn":0,"sprite_py":"telankesi2_s2","skill_name":"Siêu Saiyan - Nộ","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":500,"evo_story":"Yêu cầu: Tiến hóa +3","skill_type":"KBEATTACK","attack_effect":"","is_evolution":75121,"resource_count":0,"evo_food":5000,"action":0,"resource_type":0},"75121":{"effect_talent":0.0,"attr_effect":300,"skill_icon":"s_telankesi2_s2","cd":0,"rate":100,"skill_story":"Kĩ năng trước khi bị đánh: Gây ra effect% ST ma pháp và 200% ST thuộc tính Hỏa cho toàn phe địch.Nhận 2 tầng \"Hộ Giá\", duy trì 3 lượt.Hộ Giá: Chắn các ST trực tiếp từ địch 1 lần. (ST truy kích, ST 4 thuộc tính, Diệt Ngay, không thể dùng Hộ Giá chắn);\nHiệu quả bị động (không cần đeo kĩ năng này):\n1: Càng đánh càng mạnh: Khi bản thân còn trên chiến trường, trước khi bắt đầu lượt đấu Broli nhận buff Trói Buộc, cấm kĩ năng trước khi bị đánh của mục tiêu 1 lượt.\n2: Tăng chiến lực: Khi bản thân còn trên chiến trường, trước khi chiến đấu Songoku mới nhận hiệu quả Trói Buộc, cấm kĩ năng trước khi bị đánh của mục tiêu 1 lượt.\n3: Như thầy như bạn: Khi bản thân còn trên chiến trường, trước khi bị đánh Songohan nhận thêm 8 lần ST và hiệu quả \"Ổn Định\".\n4: Thanh Gươm Hy Vọng: Khi Broli/ Songoku/ Songohan còn trên chiến trường, kĩ năng trước khi chiến đấu của Trunks sẽ khiến mục tiêu mất 1 lượt giới hạn kĩ năng trước khi bị đánh.\n5: Trái tim Saiya: Khi 4 người đều còn trên chiến trường, lần Hồi Sinh đầu tiên không mất 