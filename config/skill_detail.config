"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"64940":{"effect_talent":0.0,"attr_effect":550,"skill_icon":"s_ailusha_xzj","cd":0,"rate":100,"skill_story":"Skill bị đánh: Bị tấn công xong, có 99% tỉ lệ tấn công 1, 3 hoặc 5 mục tiêu, tạo thấp nhất effect% ST vật lý và 550% ST t.tính Gió lên mục tiêu, tấn công càng ít người sát thương càng cao (Tấn công 3 mục tiêu tạo X2 ST vật lý, tấn công 1 mục tiêu tạo X3 ST vật lý), nếu ở trạng thái \"Thanh Tâm Y\", sẽ tăng X1 ST căn cứ ST gốc cơ bản, và hồi HP bằng 1190%-1340% Ma Công hiện tại của bản thân, mỗi hiệp tối đa phát động 2 lần","effect_lvchange":5.0,"is_learn":0,"sprite_py":"ailusha_s4","skill_name":"Tinh Kiếm-Thánh","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":640,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREHERT","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"64950":{"effect_talent":0.0,"attr_effect":800,"skill_icon":"s_ailusha_ywzn","cd":2,"rate":100,"skill_story":"Tạo effect% ST vật lý và 800% ST t.tính Gió lên toàn thể địch; Giảm 80% Tốc Độ hiện tại của 1-3 mục tiêu địch, kéo dài 3 hiệp.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"ailusha_s5","skill_name":"Fairy Nộ-Thánh","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":360,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"64960":{"effect_talent":0.0,"attr_effect":500,"skill_icon":"s_ailusha_hzmf","cd":1,"rate":100,"skill_story":"Skill trước hiệp: Bỏ quả buff Hỗn Loạn, hồi 50% HP bản thân đã mất, ngẫu nhiên biến hình, đổi thành 1 trong 2 loại: \"Thanh Tâm Y\", \"Thiên Luân Khải\", kéo dài 2 hiệp, nghỉ 1 hiệp;\nỞ trạng thái \"Thanh Tâm Y\": Chuyển Phòng Ngự của bản thân thành Vật & Ma Công, mỗi khi Erza cứ chịu ST bằng 1% HP lớn nhất của bản thân (mức sàn), đều tăng 4% Vật & Ma Công, 2% Tấn Công t.tính Gió (Tối đa tăng 400% Vật & Ma Công, 200% Tấn Công t.tính Gió); Erza ở trạng thái \"Thanh Tâm Y\", sẽ bỏ qua 99% Né của mục tiêu.\nỞ trạng thái \"Thiên Luân Khải\": Tăng 20% giới hạn HP cho bản thân, mỗi khi Erza chịu ST bằng 1% HP lớn nhất của bản thân (mức sàn), đều tăng 0.3% giới hạn HP lớn nhất, giới hạn HP tối đa tăng 30%; Erza ở trạng thái \"Thanh Tâm Y\", sẽ giảm tỉ lệ Né của bản thân xuống thấp nhất; Và khi chiến đấu có 99% tỉ lệ phản đòn ST tấn công cho phe địch, ST phản đòn bằng 20% ST bản thân phải chịu, kèm ST thực bằng effect% Phòng Ngự và Ma Công của bản thân, mỗi lần biến hình tối đa phản đòn 6 lần; 50% sát thương bản thân chịu chuyển thành hồi HP cho bản thân","effect_lvchange":0.0,"is_learn":0,"sprite_py":"ailusha_s6","skill_name":"Requip Magic-Thánh","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":600,"evo_story":"","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"64970":{"effect_talent":0.0,"attr_effect":600,"skill_icon":"s_ailusha_mfnw","cd":1,"rate":100,"skill_story":"Skill trước khi bị đánh: Tăng 50% Bạo Kích và Né cho bản thân.","effect_lvchange":0.0,"is_learn":0,"sprite_py":"ailusha_s7","skill_name":"Nữ Hoàng Magic-Thánh","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":720,"evo_story":"","skill_type":"KBEATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"75270":{"effect_talent":0.0,"attr_effect":1800,"skill_icon":"s_fulilian_s7","cd":99,"rate":100,"skill_story":"Kỹ năng tiền chiến: Vĩnh viễn tăng 220% HP tối đa của bản thân, giảm thương chỉnh thể 79%, tăng 500% Trúng Đíchm Né Tránh và Bạo Kích cho bản thân. Gây ra effect% ST ma pháp và 1800% ST thuộc tính Hoả cho toàn phe địch. Truy kích với ST thực bằng 50% HP của bản thân ","effect_lvchange":10.0,"is_learn":0,"sprite_py":"fulilian_s7","skill_name":"Ma pháp tán ma","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":