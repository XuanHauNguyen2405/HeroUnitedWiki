át thương cuối và sát thương thuộc tính.","effect_lvchange":2.0,"is_learn":0,"sprite_py":"morenbuou_s5","skill_name":"Trăng Sáng-Tàn Sát","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":600,"evo_story":"Dùng Xu có thể mở kỹ năng này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"63660":{"effect_talent":0.0,"attr_effect":650,"skill_icon":"s_mr_wjsl","cd":99,"rate":100,"skill_story":"KN trước trận: Nhân đôi tấn công thuộc tính Lửa, tạo effect% sát thương ma pháp lên toàn thể địch, tạo thêm 650% sát thương thuộc tính Lửa và 100% sát thương vật lý, bản thân thêm 1 tầng \"Vầng Sáng Tàn Sát\" vĩnh viễn (không thể xóa), tăng 150% tốc độ (2 hiệp), tăng 60% giảm thương toàn thể (3 hiệp).","effect_lvchange":0.0,"is_learn":0,"sprite_py":"morenbuou_s6","skill_name":"Trăng Sáng-Loạn Xạ","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":648,"evo_story":"","skill_type":"KBEFOREBATTLE","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"63670":{"effect_talent":0.0,"attr_effect":600,"skill_icon":"s_mr_rqzd","cd":99,"rate":100,"skill_story":"KN tử trận: Tạo effect% sát thương ma pháp và 600% sát thương thuộc tính Lửa lên toàn thể địch, xóa buff tốt (có thể xóa) của toàn thể mục tiêu.","effect_lvchange":0.0,"is_learn":0,"sprite_py":"morenbuou_s7","skill_name":"Trăng Sáng-Bom Ma Thuật","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":648,"evo_story":"","skill_type":"KDEAD","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"63710":{"effect_talent":0.0,"attr_effect":160,"skill_icon":"s_nd_tiantian","cd":4,"rate":50,"skill_story":"Trêu chọc mục tiêu mặc định hoặc dãy sau địch, tạo eeffect% sát thương ma pháp và 160% sát thương thuộc tính Đất.","effect_lvchange":2.0,"is_learn":0,"sprite_py":"nvdi_s1_1","skill_name":"Trăng Sáng-Mũi Tên Kẹo","max_lv":30,"pre_cd":0,"e