d":0,"rate":100,"skill_story":"KN trước khi chịu đòn: Chặn tấn công của phái nữ, có 99% tỉ lệ, hồi 50% HP bản thân bằng tất cả dmg tấn công của phái nữ; Khi thả skill này vào hiệp lẻ, có 1 lần cơ hội hồi sinh (Hiệp chẵn không hồi sinh, hiệp trước trận là hiệp lẻ, mỗi hiệp chỉ kích hoạt HQ 1 lần), hồi sinh xong hồi 50% HP bản thân.","effect_lvchange":1.0,"is_learn":0,"sprite_py":"Sanji_s4","skill_name":"Kỵ Sĩ Đạo","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":20,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"21450":{"effect_talent":0.0,"attr_effect":1200,"skill_icon":"s_Sanji_gpt","cd":2,"rate":100,"skill_story":"Tấn công tất cả hero nam phe địch, tạo effect% dmg vật lý & 800% dmg t.tính Lửa; Làm 1 mục tiêu Sợ trong 2 hiệp, khiến hắn rơi vào trạng thái Cháy, dmg Cháy bằng X2 dmg t.tính Lửa, 2 hiệp; Nếu Zoro bên địch có mặt, tạo thêm 50% dmg lên Zoro.","effect_lvchange":3.0,"is_learn":0,"sprite_py":"Sanji_s5","skill_name":"Quang Phổ Thích","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1000,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"21460":{"effect_talent":0.0,"attr_effect":500,"skill_icon":"s_Sanji_hhsz","cd":1,"rate":100,"skill_story":"KN trước hiệp: Cứ có mặt 1 hero nữ, đều tăng 50% Tấn Công Vật Lý & 200% Tốc Độ bản thân, nếu Luffy có mặt ở phe ta, sẽ tăng 80% Vật Công của Luffy.","effect_lvchange":0.0,"is_learn":0,"sprite_py":"Sanji_s6","skill_name":"Sứ Giả Hộ Hoa","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":50,"evo_story":"","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"21470":{"effect_talent":0.0,"attr_effect":550,"skill_icon":"s_Sanji_dyhy","cd":0,"rate":100,"skill_story":"KN bị đánh: B