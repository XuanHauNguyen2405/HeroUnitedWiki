pe":0},"65440":{"effect_talent":0.0,"attr_effect":800,"skill_icon":"s_quandajiang_skill4","cd":2,"rate":100,"skill_story":"Tấn công mục tiêu dãy trước, tạo effect% ST vật lý & 800% ST t.tính Gió lên mục tiêu","effect_lvchange":5.0,"is_learn":0,"sprite_py":"quandajiang_s4","skill_name":"Tessaiga.Khuyển Nha Đao","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":500,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"65450":{"effect_talent":0.0,"attr_effect":850,"skill_icon":"s_quandajiang_skill5","cd":2,"rate":100,"skill_story":"Tấn công toàn thể phe địch, bỏ qua 50% Phòng Ngự của mục tiêu, tạo effect% Vật & Ma Công và 850% ST t.tính Gió.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"quandajiang_s5","skill_name":"Hóa Hình.Khuyển Yêu Trảo","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":350,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"65460":{"effect_talent":0.0,"attr_effect":850,"skill_icon":"s_quandajiang_skill6","cd":1,"rate":100,"skill_story":"Skill trước hiệp: Tấn công 1 mục tiêu, căn cứ trạng thái của mục tiêu thả skill khác nhau, hồi 50% HP bản thân đã mất.\n\nNếu mục tiêu ở trạng thái vô địch: Thả \"Thiết Toái Nha đỏ\", bỏ qua trạng thái vô địch, tạo ST thực bằng effect% Vật Công, không tạo ST thuộc tính;\nNếu mục tiêu không ở trạng thái vô địch, và HP dưới 40%, sẽ kết liễu mục tiêu;\nNếu mục tiêu không ở trạng thái vô địch, và HP trên 40%, Vật & Ma Công cao hơn bản thân, sẽ tấn công mục tiêu tạo effect% ST ma pháp và 850% ST t.tính Gió, hút 80% Vật & Ma Công của mục tiêu (Giảm của mục tiêu phe địch, tăng t.tính bản thân), lần sau tấn công có hiệu lực, hiệu lực 1 hiệp;\nNếu mục tiêu không tồn tại 3 trạng thái trên, sẽ thả \"Kim Cang Thương Phá\", tấn công toàn thể mục tiêu, tạo effect% ST vật lý và 850% ST t.tính Gió, khiến 1 mục tiêu hỗn loạn, hiệu lực 1 hiệp.\n","effect_lvchange":0.0,"is_learn":0,"sprite_py":"quandajiang_s6","skill_name":"So'unga.Ngục Long Phá","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":700,"evo_story":"","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"65470":{"effect_talent":0.0,"attr_effect":650,"skill_icon":"s_quandajiang_skill7","cd":99,"rate":100,"skill_story":"Skill trước khi bị đánh: Tăng effect% Chính Xác và tỉ lệ bạo kích của đồng đội","effect_lvchange":0.0,"is_learn":0,"sprite_py":"quandajiang_s7","skill_name":"Yêu Vương Lực","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":150,"evo_story":"","skill_type":"KBEATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"65510":{"effect_talent":0.0,"attr_effect":200,"skill_icon":"s_Ichig1_skill1","cd":4,"rate":50,"skill_story":"Tấn công mục tiêu mặc định, tạo effect% ST vật lý và 200% ST t.tính Gió, giảm 50% Né của mục tiêu.","effect_lvchange":1.0,"is_learn":0,"sprite_py":"Ichig1_s1","skill_name":"Bleach-Kiếm Áp","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":120,"evo_story":"","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":65511,"resource_count":0,"evo_food":5000,"action":0,"resource_type":0},"65511":{"effect_talent":0.0,"attr_effect":250,"skill_icon":"s_Ichig1_skill1","cd":4,"rate":100,"skill_story":"Tấn công mục tiêu mặc định, tạo effect% ST vật lý và 250% ST t.tính Gió, giảm 50% Né của mục tiêu.","effect_lvchange":1.0,"is_learn":0,"sprite_py":"Ichig1_s1","skill_name":"Bleach-Kiếm Áp·Cấp 2","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":5,"effect":132,"evo_story":"Điều kiện tiến cấp: Đồng đội tiến cấp đến+7","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":65512,"resource_count":0,"evo_food":30000,"action":0,"resource_type":0},"65512":{"effect_talent":0