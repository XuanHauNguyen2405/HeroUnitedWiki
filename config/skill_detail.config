ờng, có 50% tỉ lệ làm 1 mục tiêu trọng thương, -70% năng lực hồi HP của mục tiêu; Hiệp này đồng đội thả TC chủ động hoặc TC thường, đều giảm Phòng Ngự của mục tiêu, lượng giảm = 50% Phòng Ngự của Shermie, hiệu lực 2 hiệp, tối đa cộng dồn 5 tầng (Tấn công của Shermie ko gồm buff này).","effect_lvchange":0.0,"is_learn":0,"sprite_py":"Shermie_s7","skill_name":"Ám Lôi","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":600,"evo_story":"","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"69250":{"effect_talent":0.0,"attr_effect":950,"skill_icon":"s_shenleqianhe_s5","cd":2,"rate":100,"skill_story":"Tấn công tất cả thuộc tính chuyển thành vật công, tạo effect% ST vật lý và 950% ST thực t.tính Lửa lên toàn thể phe địch, giảm 50% vật & ma công của toàn thể phe địch 2 hiệp, ngẫu nhiên khiến mục tiêu đứng im hoặc hóa đá 2 hiệp.\"","effect_lvchange":10.0,"is_learn":0,"sprite_py":"shenleqianhe_s5","skill_name":"Ngọc Sắt Âm.Thánh","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":650,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"22310":{"effect_talent":0.0,"attr_effect":250,"skill_icon":"s_zhujian_skill1","cd":4,"rate":50,"skill_story":"Tấn công 1 mục tiêu, tạo effect% ST vật lý & 250% ST thuộc tính Đất, khiến mục tiêu Tụt Máu, mỗi hiệp tạo gấp đôi ST của tổng ST Tụt Máu, kéo dài 2 hiệp.","effect_lvchange":2.0,"is_learn":0,"sprite_py":"qianshouzhujian_s1","skill_name":"Gai Sát Thuật","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":250,"evo_story":"","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":22311,"resource_count":0,"evo_food":5000,"action":0,"resource_type":0},"22311":{"effect_talent":0.0,"attr_effect":300,"skill_icon":"s_zhujian_skill1","cd":4,"rate":100,"skill_story":"Tấn công 1 mục tiêu, tạo effect% ST vật lý & 3