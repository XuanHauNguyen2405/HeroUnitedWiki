n thể phe địch effect% ST Ma Công và ST bằng 800% ST thực thuộc tính Đất, tăng 79% giảm thương tổng thể của bản thân, tăng 100% giới hạn HP của bản thân, tăng effect% tấn công thuộc tính Đất của bản thân, vĩnh viễn tăng 200% Trúng, Né và Bạo Kích, tạo x4-6 ST và ST thuộc tính, trói buộc ngẫu nhiên 3 kẻ địch, kéo dài 1 hiệp.","effect_lvchange":0.0,"is_learn":0,"sprite_py":"xiangpa_s7","skill_name":"Hộ Vệ Của Thần","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":500,"evo_story":"","skill_type":"KBEFOREBATTLE","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"69950":{"effect_talent":0.0,"attr_effect":950,"skill_icon":"s_foladesanshi_s5","cd":2,"rate":100,"skill_story":"Tạo effect% ST vật lý và 950% ST t.tính Nước lên toàn thể phe địch, trong hiệp này giảm 100% tấn công t.tính Lửa, Phòng Ngự và Né của kẻ địch (sinh hiệu quả ST trong lần tấn công này), hồi toàn bộ HP cho bản thân.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"foladesanshi_s5","skill_name":"Cúp Thánh Đen.Thánh","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":650,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"26510":{"effect_talent":0.0,"attr_effect":500,"skill_icon":"s_longjuan_s1","cd":4,"rate":50,"skill_story":"Tạo lên 3~5 kẻ địch bất kì effect% ST Ma Công và 500% ST thuộc tính Gió, tạo x3-5 ST và ST thuộc tính, khiến mục tiêu bị trói buộc.","effect_lvchange":2.0,"is_learn":0,"sprite_py":"longjuan_s1","skill_name":"Thiên Thạch","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":250,"evo_story":"","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":26511,"resource_count":0,"evo_food":5000,"action":0,"resource_type":0},"26511":{"effect_talent":0.0,"attr_effect":550,"skill_icon":"s_longjuan_s1","cd":4,"rate":100,"skill_story":"Tạo lên 3~5 kẻ địch bất kì effect% ST Ma Công và