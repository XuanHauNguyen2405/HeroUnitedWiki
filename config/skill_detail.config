% ST ma pháp và 900% ST t.tính Đất lên mục tiêu.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"Kevlar_s5","skill_name":"Pháo Đạn Khí","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":600,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"220260":{"effect_talent":0.0,"attr_effect":650,"skill_icon":"s_mr_wjsl","cd":99,"rate":100,"skill_story":"战前技：将自身火属性攻击翻倍，对敌方全体造成effect%魔法伤害，额外造成650%火属性伤害，并对敌方全体额外造成100%的物理伤害，为自身添加一层永久性的“杀戮光环”，提升150%的自身速度（持续2回合），并增加整体减伤60%（持续3个回合），以上光环均不可被移除。","effect_lvchange":0.0,"is_learn":0,"sprite_py":"boss_morenbuou_s6","skill_name":"魔人乱射","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":540,"evo_story":"","skill_type":"KBEFOREBATTLE","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"23660":{"effect_talent":0.0,"attr_effect":800,"skill_icon":"s_Kevlar_s6","cd":1,"rate":100,"skill_story":"Skill trước hiệp: Di chuyển nhanh, tăng effect% Né, 69% giảm thương tổng thể cho bản thân, hồi tất cả HP bản thân đã mất, giảm 15%-55% Né của toàn thể địch, hiệu lực 1 hiệp, và có 80% tỉ lệ chế giễu 1 mục tiêu.","effect_lvchange":0.0,"is_learn":0,"sprite_py":"Kevlar_s6","skill_name":"Di Chuyển Cấp Tốc","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":150,"evo_story":"","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"220270":{"effect_talent":0.0,"attr_effect":600,"skill_icon":"s_mr_rqzd","cd":99,"rate":100,"skill_story":"死亡技：魔人布欧濒死状态下跳向敌方目标，对敌方全体目标造成effect%魔法伤害，及600%自身火属性伤害，并清除全体目标身上的可移除增益BUFF。","effect_lvchange":0.0,"is_learn":0,"sprite_py":"boss_morenbuou_s7","skill_name":"魔人炸弹","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":540,"evo_story":"","skill_type":"KDEAD","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resou