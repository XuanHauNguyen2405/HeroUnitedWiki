+60","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"23240":{"effect_talent":0.0,"attr_effect":800,"skill_icon":"s_Frieza_s4","cd":0,"rate":100,"skill_story":"Skill phản đòn: Bị tấn công xong, 99% tỉ lệ phản đòn mục tiêu tấn công bản thân, tạo effect% ST ma pháp & 800% ST t.tính Lửa, và trói buộc mục tiêu tấn công mình, khiến mục tiêu mất đi năng lực hành động 1 hiệp; giảm 30%-50% Né của mục tiêu 1 hiệp, mỗi hiệp tối đa phát động 2 lần.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"Frieza_s4","skill_name":"Bóng Giam Cầm","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":600,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREHERT","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"23250":{"effect_talent":0.0,"attr_effect":900,"skill_icon":"s_Frieza_s5","cd":2,"rate":100,"skill_story":"Tấn công toàn thể mục tiêu địch, tạo effect% ST ma pháp & 900% ST t.tính Lửa, khiến 1-2 mục tiêu hỗn loạn 1 hiệp, và tăng 10% năng lực hồi HP cho cả đội, kéo dài 1 hiệp.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"Frieza_s5","skill_name":"Bom Hủy Diệt","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":600,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"23260":{"effect_talent":0.0,"attr_effect":800,"skill_icon":"s_Frieza_s6","cd":1,"rate":100,"skill_story":"Skill trước hiệp: Tạo effect% ST ma pháp & 800% ST t.tính Lửa lên 3 mục tiêu; Hồi tất cả HP đã mất cho bản thân, tăng 79% giảm thương tổng thể, kéo dài 1 hiệp; Nếu năng lực hồi phục của mục tiêu có tăng hoặc giảm, sẽ chịu thêm X4 sát thương ma pháp & sát thương t.tính Lửa.","effect_lvchange":0.0,"is_learn":0,"sprite_py":"Frieza_s6","skill_name":"Sao Băng Tử Thần","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":800,"evo_story":"","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"23270":{"effect_talent":0.0,"attr_effect":600,"skill_icon":"s_Frieza_s7","cd":99,"rate":100,"skill_story":"Skill tử trận: Tăng 50% năng lực hồi phục của cả đội, hồi sinh biến hình thành Frieza hoàng kim, hồi tất cả HP cho bản thân, tăng vĩnh viễn 50% tấn công t.tính Lửa & toàn thuộc tính; Tăng effect% phòng ngự & thuộc tính phòng ngự, kéo dài 3 hiệp.","effect_lvchange":0.0,"is_learn":0,"sprite_py":"Frieza_s7","skill_name":"Thức Tỉnh Hồi Sinh","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":600,"evo_story":"","skill_type":"KDEAD","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"23310":{"effect_talent":0.0,"attr_effect":500,"skill_icon":"s_Iori_s1","cd":4,"rate":50,"skill_story":"Tấn công mục tiêu mặc định, tạo effect% ST vật lý và 500% ST thuộc tính Lửa; 50% tỉ lệ khiến mục tiêu rơi vào trạng thái cháy, mỗi hiệp tạo ST cháy = 20%-35% HP lớn nhất của bản thân Yagami Iori, hiệu lực 1 hiệp; Ở trạng thái thức tỉnh, sẽ đổi sang tấn công mục tiêu hàng mặc định.","effect_lvchange":2.0,"is_learn":0,"sprite_py":"Iori_s1","skill_name":"Ám Phù","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":250,"evo_story":"","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":23311,"resource_count":0,"evo_food":5000,"action":0,"resource_type":0},"23311":{"effect_talent":0.0,"attr_effect":550,"skill_icon":"s_Iori_s1","cd":4,"rate":100,"skill_story":"Tấn công mục tiêu mặc định, tạo effect% ST vật lý và 550% ST thuộc tính Lửa; 50% tỉ lệ khiến mục tiêu rơi vào trạng thái cháy, mỗi hiệp tạo ST cháy = 20%-35% HP lớn nhất của bản thân Yagami Iori, hiệu lực 1 hiệp; Ở trạng thái thức tỉnh, sẽ đổi sang tấn công mục tiêu hàng mặc định.","effect_lvchange":2.0,"is_learn":0,"sprite_py":"Iori_s1","skill_name":"Ám Phù.Cấp 1","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":5,