 đỏ","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":5,"evo_story":"Yêu cầu: Tiến hóa+4","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":921,"resource_count":10000,"evo_food":5000,"action":3,"resource_type":3},"90121":{"effect_talent":0.0,"attr_effect":130,"skill_icon":"s_huolang.png","cd":2,"rate":100,"skill_story":"Tạo 1 lần sát thương ma pháp effect% cho toàn bộ đơn vị địch, có 50% tỉ lệ khiến mục tiêu bị thiêu đốt, kẻ bị thiêu mỗi hiệp giảm 5% HP (không quá 50% vật công), kéo dài 3 hiệp. Tạo thêm 130% sát thương thuộc tính lửa của bản thân.","effect_lvchange":1.0,"is_learn":1,"sprite_py":"gace_s3_1.py","skill_name":"Sóng lửa","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":80,"evo_story":"Yêu cầu: Tiến hóa+2","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":931,"resource_count":10000,"evo_food":5000,"action":3,"resource_type":3},"90122":{"effect_talent":0.0,"attr_effect":130,"skill_icon":"s_jianrenfengbao.png","cd":99,"rate":100,"skill_story":"Kĩ năng trước trận. Tiên phát chế nhân, lấy ra một chiếc trực thăng nhào vào đối phương, tạo effect% sát thương vật lí cho toàn bộ địch, đồng thời tăng 20% tốc độ toàn bộ phe ta, kéo dài 3 hiệp. Tạo thêm 130% sát thương thuộc tính gió của bản thân.","effect_lvchange":1.0,"is_learn":1,"sprite_py":"magneto_s1_1","skill_name":"Oanh tạc kim loại","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":90,"evo_story":"","skill_type":"KBEFOREBATTLE","attack_effect":"","is_evolution":3311,"resource_count":10000,"evo_food":5000,"action":3,"resource_type":3},"90123":{"effect_talent":0.0,"attr_effect":160,"skill_icon":"s_quntidaji.png","cd":2,"rate":100,"skill_story":"Magneto đố kị căm thù người thường. Điều khiển quả cầu kim loại tấn công mục tiêu liên tục, tổng cộng tạo effect% sát thương vật lí, đối với kẻ địch đến từ thế giới lí tính tạo thêm 50% sát thương. Tạo thêm 160% sát thương thuộc tính gió của bản thân.","effect_lvchange":4.0,"is_learn":1,"spri