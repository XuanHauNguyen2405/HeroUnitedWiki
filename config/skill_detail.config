rước phe địch, tạo effect% dmg vật lý và 550% dmg t.tính Gió.","effect_lvchange":5.0,"is_learn":0,"sprite_py":"ailusha_s3","skill_name":"Trăng Sáng cấp 8","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":450,"evo_story":"Yêu cầu: Tiến hóa +60","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"21640":{"effect_talent":0.0,"attr_effect":550,"skill_icon":"s_ailusha_xzj","cd":0,"rate":100,"skill_story":"KN bị đánh: Sau khi bị đánh, có 99% tỉ lệ tấn công 1, 3 hoặc 5 kẻ địch, tạo tối thiểu effect% dmg vật lý và 550% dmg t.tính Gió, tấn công càng ít người, dmg càng cao (Đánh 3 mục tiêu tạo X2 dmg vật lý, đánh 1 mục tiêu tạo X3), nếu ở trạng thái \"Thanh Tâm\", tăng X1 dmg dựa trên dmg cơ bản, và hồi HP bằng 1100%-1250% Ma Công hiện tại, mỗi hiệp tối đa phát động 2 lần.","effect_lvchange":5.0,"is_learn":0,"sprite_py":"ailusha_s4","skill_name":"Tinh Kiếm","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":550,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREHERT","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"21650":{"effect_talent":0.0,"attr_effect":800,"skill_icon":"s_ailusha_ywzn","cd":2,"rate":100,"skill_story":"Tạo effect% dmg vật lý và 800% dmg t.tính Gió cho tất cả địch; Giảm 80% Tốc Độ hiện tại của 1-3 kẻ địch, kéo dài 3 hiệp.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"ailusha_s5","skill_name":"Fairy Nộ","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":300,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"21660":{"effect_talent":0.0,"attr_effect":500,"skill_icon":"s_ailusha_hzmf","cd":1,"rate":100,"skill_story":"KN trước hiệp: Bỏ qua HQ Hỗn Loạn, hồi 50% HP bản thân đã mất, ngẫu nhiên thay trang bị thành \"Thanh Tâm\" hoặc \"Thiên Luân\", kéo dài 2 hiệp, cách 1 hiệp;\n\"Thanh Tâm\": Chuyển Phòng Ngự thành Vật & Ma Công, khi Erza chịu dmg bằng 1% HP tối đa của mình (Ở trang tướng) , đều tăng 4% Vật & Ma Công, 2% Tấn Công t.tính Gió (Tối đa tăng 400% Vật & Ma Công, 200% Tấn Công t.tính Gió); Erza ở trạng thái Thanh Tâm, sẽ bỏ qua 99% Né của mục tiêu.\n\"Thiên Luân\": Tăng 20% giới hạn HP, khi Erza chịu dmg bằng 1% HP tối đa của mình (Ở trang tướng), đều tăng 0.3% giới hạn HP tối đa, giới hạn HP tăng tối đa 30%; Erza ở trạng thái Thiên Luân, giảm Né bản thân xuống thấp nhất; sau đó sẽ có 99% tỉ lệ phản đòn cho phe tấn công, dmg phản đòn bằng 20% dmg bản thân chịu, kèm dmg thực bằng effect% Phòng Ngự & Ma Công của mình, mỗi lần requip xong tối đa phản đòn 6 lần; hồi HP cho bản thân bằng 50% dmg mình đã chịu.","effect_lvchange":0.0,"is_learn":0,"sprite_py":"ailusha_s6","skill_name":"Requip Magic","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":500,"evo_story":"","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"21670":{"effect_talent":0.0,"attr_effect":600,"skill_icon":"s_ailusha_mfnw","cd":1,"rate":100,"skill_story":"KN trước khi bị đánh: Tăng 50% Bạo Kích và Né cho mình","effect_lvchange":0.0,"is_learn":0,"sprite_py":"ailusha_s7","skill_name":"Nữ Hoàng Magic","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":600,"evo_story":"","skill_type":"KBEATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"69150":{"effect_talent":0.0,"attr_effect":950,"skill_icon":"s_sishi_s5","cd":2,"rate":100,"skill_story":"Tạo effect% ST vật lý và 900% ST thực t.tính Lửa lên toàn thể phe địch, 50% tỉ lệ khiến mục tiêu rơi vào trạng thái tụt máu, mỗi hiệp tạo x3 sát thương tấn công t.tính Lửa, kéo dài 2 hiệp.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"sishi_s5","skill_name":"Hồi Máu.Thánh","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":650,"evo_story":"Dùng Xu