change":10.0,"is_learn":0,"sprite_py":"Hisoka_s5","skill_name":"ACE","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":600,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"24760":{"effect_talent":0.0,"attr_effect":800,"skill_icon":"s_Hisoka_s6","cd":1,"rate":100,"skill_story":"Skill trước hiệp: Tăng 89% giảm thương tổng thể, tạo effect% ST ma công và % ST t.tính Nước lên toàn thể địch, làm mục tiêu mặc định mù 1 hiệp, nếu mục tiêu đã có hiệu quả gây mù, cộng dồn 1 tầng hiệu quả tụt máu, mỗi hiệp tạo effect% ST thực của tấn công t.tính Nước, kéo dài 1 hiệp.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"Hisoka_s6","skill_name":"Kẹo Niệm Lực","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":800,"evo_story":"","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"24770":{"effect_talent":0.0,"attr_effect":800,"skill_icon":"s_Hisoka_s7","cd":0,"rate":100,"skill_story":"Skill tử trận: Hồi sinh sau khi tử trận, hồi tất cả HP. Tăng vĩnh viễn effect% ST ma pháp và 800k-1100k tấn công t.tính Nước cho bản thân. Sau khi hồi sinh, tăng vĩnh viễn 60% sát thương skill ACE. Tối đa có thể hồi sinh 2 lần.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"Hisoka_s7","skill_name":"Ảo Tưởng Mảnh","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":800,"evo_story":"","skill_type":"KDEAD","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"69670":{"effect_talent":0.0,"attr_effect":650,"skill_icon":"s_baishenwukong_s7","cd":99,"rate":100,"skill_story":"Skill trước trận: Tạo effect% ST ma công và 650% ST thực t.tính Gió lên toàn thể phe địch, vĩnh viễn tăng 800% phòng ngự và t.tính phòng ngự cho bản thân, vĩnh viễn tăng 79% giảm thương tổng thể cho bản thân, tăng 30%~60% Vật & Ma Công của bản thân, kéo dài 2