":"Bản năng đoán được hành động của đối phương, khi phe bị tấn công tốc độ cao hơn bản thân 80% thì nhất định chính xác và nhất định bạo kích.","effect_lvchange":0.0,"is_learn":1,"sprite_py":"","skill_name":"Sức mạnh Lv4","max_lv":20,"pre_cd":0,"effect_delay":0,"skill_quality":5,"effect":0,"evo_story":"Yêu cầu: Tiến hóa +26","skill_type":"KATTACK","attack_effect":"","is_evolution":1514,"resource_count":10000,"evo_food":10000,"action":3,"resource_type":3},"67050":{"effect_talent":0.0,"attr_effect":900,"skill_icon":"s_Iori_s5","cd":2,"rate":100,"skill_story":"Tấn công 1 mục tiêu, nếu mục tiêu rơi vào trạng thái vô địch, tạo effect% ST vật lý và 900% ST t.tính Lửa và tạo thêm ST thực bằng 20% HP lớn nhất hiện tại của mục tiêu (Bỏ qua HQ vô địch), nếu mục tiêu không có HQ vô địch, sẽ có 60% tỉ lệ kết liễu mục tiêu đó, và sát thương mục tiêu khác, tạo effect% ST vật lý và ST t.tính Lửa; Ở trạng thái thức tỉnh, tỉ lệ kết liễu tăng đến 80%, ST tăng đến 30% HP lớn nhất hiện tại của mục tiêu.","effect_lvchange":15.0,"is_learn":0,"sprite_py":"Iori_s5","skill_name":"Bát Trĩ Nữ-Thánh","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":600,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"71250":{"effect_talent":0.0,"attr_effect":950,"skill_icon":"s_juyoujing_s5","cd":2,"rate":100,"skill_story":"Tạo effect% ST Vật Lý và 900% ST thuộc tính Nước lên toàn thể phe địch, nếu HP bản thân dưới 50%, chọn và kết liễu ngẫu nhiên 1 mục tiêu. ","effect_lvchange":10.0,"is_learn":0,"sprite_py":"juyoujing_s5","skill_name":"La Sát","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":650,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"1520":{"effect_talent":0.0,"attr_effect":100,"skill_icon":"s_jirouzhuangjia.png","cd":1,"rate":0,"skil