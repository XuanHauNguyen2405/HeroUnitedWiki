s_dakongyi_s5","cd":2,"rate":100,"skill_story":"Chuyển hóa Vật Công thành Ma Công, chuyển hóa tấn công của tất cả thuộc tính thành Ma Công, tạo ST thực bằng effect% ST ma pháp lên toàn thể kẻ địch. Trong bóng có chứa các loại thuộc tính, sau khi bóng phát nổ sẽ có 30% tỉ lệ tạo hiệu quả cháy, tụt máu, mù, bỏng lạnh lên toàn thể kẻ địch. Mỗi hiệp tạo ST thực bằng effect% lực tấn công t.tính Gió","effect_lvchange":10.0,"is_learn":0,"sprite_py":"dakongyi_s5","skill_name":"Ngả Người Móc Bóng","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":600,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"24360":{"effect_talent":0.0,"attr_effect":800,"skill_icon":"s_dakongyi_s6","cd":1,"rate":100,"skill_story":"Skill trước hiệp: Tạo effect% ST ma pháp và 800% ST t.tính Gió lên toàn thể kẻ địch. Hồi tất cả HP đã mất. Tạo hiệu quả tụt máu lên phe địch, mỗi hiệp tạo ST thực bằng effect% tấn công t.tính Gió.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"dakongyi_s6","skill_name":"Tung Cánh Sút Bóng","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":800,"evo_story":"","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"24370":{"effect_talent":0.0,"attr_effect":600,"skill_icon":"s_dakongyi_s7","cd":99,"rate":100,"skill_story":"Skill trước trận: Tăng 79% tỉ lệ giảm thương tổng thể, tăng vĩnh viễn 800% phòng ngự tổng thể cho bản thân, tăng vĩnh viễn 200% Trúng, Né và bạo kích. Miễn dịch vĩnh viễn hiệu quả Đứng Im, Hóa Đá, Choáng, Trói Buộc, Chế Giễu, Mê Hoặc.","effect_lvchange":0.0,"is_learn":0,"sprite_py":"dakongyi_s7","skill_name":"Màn Ánh Sáng Nữ Thần","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":200,"evo_story":"","skill_type":"KBEFOREBATTLE","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"