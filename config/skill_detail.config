fect_delay":0,"skill_quality":7,"effect":350,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"65360":{"effect_talent":0.0,"attr_effect":850,"skill_icon":"s_ssw_hurt","cd":1,"rate":100,"skill_story":"Skill trước hiệp: Tấn công 1 mục tiêu, căn cứ trạng thái của mục tiêu thả skill khác nhau, hồi 50% HP bản thân đã mất.\n\nNếu mục tiêu ở trạng thái vô địch: Thả \"Thiết Toái Nha đỏ\", bỏ qua trạng thái vô địch, tạo ST thực bằng effect% Vật Công, không tạo ST thuộc tính;\nNếu mục tiêu không ở trạng thái vô địch, và HP dưới 40%, sẽ thả \"Minh Đạo Tàn Nguyệt Phá\", kết liễu mục tiêu;\nNếu mục tiêu không ở trạng thái vô địch, và HP trên 40%, Vật & Ma Công cao hơn bản thân, sẽ thả \"Long Lân Thiết Toái Nha\", tấn công mục tiêu tạo effect% ST ma pháp và 800% ST t.tính Gió, hút 80% Vật & Ma Công của mục tiêu (Giảm của mục tiêu phe địch, tăng t.tính bản thân), lần sau tấn công có hiệu lực, hiệu lực 1 hiệp;\nNếu mục tiêu không tồn tại 3 trạng thái trên, sẽ thả \"Kim Cang Thương Phá\", tấn công toàn thể mục tiêu, tạo effect% ST vật lý và 800% ST t.tính Gió, khiến 1 mục tiêu hỗn loạn, hiệu lực 1 hiệp.\n","effect_lvchange":0.0,"is_learn":0,"sprite_py":"Inuyasha1_s6","skill_name":"Tessaiga-Thánh","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":700,"evo_story":"","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"65370":{"effect_talent":0.0,"attr_effect":650,"skill_icon":"s_ssw_cure","cd":99,"rate":100,"skill_story":"Skill trước khi bị đánh: Tăng effect% Chính Xác và tỉ lệ bạo kích của đồng đội","effect_lvchange":0.0,"is_learn":0,"sprite_py":"Inuyasha1_s7","skill_name":"Khuyển Yêu-Thánh","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":150,"evo_story":"","skill_type":"KBEATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"res