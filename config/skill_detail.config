 năng trước lượt đấu: Gây ra ST thực bằng effect% lực công ma pháp và 1800% ST thuộc tính Địa. Gây nên ST truy kích bằng 70% HP max bản thân. Ở trạng thái \"Cực Ý Gogeta\", Diệt Ngay ngẫu nhiên 1 đơn vị địch.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"beijita2_s5","skill_name":"Chiến pháp của hoàng tử","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"7702200":{"effect_talent":0.0,"attr_effect":300,"skill_icon":"s_vegettopf_s2","cd":0,"rate":100,"skill_story":"Kĩ năng cảm tri: Trước khi gặp phải tấn công của phe địch, nhận 1 tầng \"Gợi Đòn\"; Hồi 38% ST max; Nhận hiệu ứng bị động: Tăng kĩ năng trước lượt đấu của phe Ngọc Rồng và hiệu ứng kĩ năng Hồi Sinh: Nếu có Vegito trong trận, được Diệt Ngay thêm 1 kẻ địch; nhận hiệu ứng \"Ổn Định\".\nPhe Ngọc Rồng bao gồm: Cuồng - Broli/ Kakalot/Gohan Dã Thú/Kiếm Hy Vọng/Vegeta.(Hiệu ứng Skin: Thẻ Phe không nhận Bị Động nữa; bản thân nhận 2 tầng Gợi Đòn, lượng HP max được hồi phục lên tới 100%)","effect_lvchange":3.0,"is_learn":0,"sprite_py":"vegetto_s2","skill_name":"Phòng hộ năng lượng - Giai 3","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":6,"effect":700,"evo_story":"Điều kiện tiến cấp: Đồng đội tiến cấp đến +20","skill_type":"KBEATTACK","attack_effect":"","is_evolution":77023,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"108627":{"effect_talent":0.0,"attr_effect":100,"skill_icon":"s_laoshuyao","cd":0,"rate":100,"skill_story":"Túy Kích (Skill buff trước hiệp): Mỗi lần thả cộng effect% toàn thuộc tính và HP cho bản thân, tối đa dồn 3 tầng, X2 phòng ngự thuộc tính","effect_lvchange":10.0,"is_learn":0,"sprite_py":"boss_bawangwan_s2_8","skill_name":"Túy Kích","max_lv":7,"pre_cd":1,"effect_delay":0,"skill_quality":0,"effect":30,"evo_story":"Yêu cầu: Tiến hóa+55","skill_type":"KBEFOREROUND","attack_effect":"",