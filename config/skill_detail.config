:"","is_evolution":334,"resource_count":10000,"evo_food":10000,"action":3,"resource_type":3},"65870":{"effect_talent":0.0,"attr_effect":800,"skill_icon":"s_yingyan_lt","cd":1,"rate":100,"skill_story":"Skill trước khi bị đánh: Tấn công mục tiêu địch có HP cao nhất (Trừ mục tiêu sắp tấn công bản thân), tạo effect% ST vật lý và 800% ST t.tính Gió lên mục tiêu; Tăng 200% tỉ lệ bạo kích, kéo dài 1 hiệp, tăng 100% tỉ lệ Né cho đồng đội, hiệp này có hiệu lực.","effect_lvchange":0.0,"is_learn":0,"sprite_py":"yingyan_s7","skill_name":"Yoru \"Đột Kích\"-Thánh","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":600,"evo_story":"","skill_type":"KBEATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"7706000":{"effect_talent":0.0,"attr_effect":1200,"skill_icon":"s_vegettopf_s6","cd":0,"rate":100,"skill_story":"Kĩ năng Tử Vong: Khi Hồi Sinh sẽ có tăng tỉ lệ không tốn số lần Hồi Sinh dựa theo số người cùng phe Ngọc Rồng có trên trường đấu, mỗi 1 người tăng 10% (Hiệu ứng Skin: Không cần có đồng đội cùng phe Ngọc Rồng trên trận, có tỉ lệ 40% được Hồi Sinh không tốn số lượt, sau khi Chuyển Sinh tăng lên 60%); Hồi toàn bộ HP bản thân (bỏ qua Trọng Thương). Gây ra ST thật bằng effect% tấn công ma pháp và 1500% ST thuộc tính Hoả cho toàn phe địch, tối đa Hồi Sinh 3 lần. Diệt Ngay ngẫu nhiên 1 mục tiêu phe địch.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"vegetto_s6","skill_name":"Nguyên tử bộc phát","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":1500,"evo_story":"","skill_type":"KDEAD","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"65910":{"effect_talent":0.0,"attr_effect":250,"skill_icon":"s_Shermie_wy","cd":4,"rate":50,"skill_story":"Ngẫu nhiên tấn công 1 mục tiêu địch, chuyển hóa tấn công t.tính Nước thành Ma Công, tạo effect% ST ma pháp.\nBất kỳ skill tấn công của Shermie, đều dồn 1-3 tầng hiệu quả Cảm Điện lên mục tiêu địch bị tấn công, mỗi tầng đều khiến sát thương tấn công kế tiếp của Shermie tăng 30%; Hiệu quả Cảm Điện kéo dài 3 hiệp sẽ mất, tối đa dồn 10 tầng.","effect_lvchange":7.0,"is_learn":0,"sprite_py":"Shermie_s1","skill_name":"Lôi Vân-Thánh","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":250,"evo_story":"","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":65911,"resource_count":0,"evo_food":5000,"action":0,"resource_type":0},"65911":{"effect_talent":0.0,"attr_effect":300,"skill_icon":"s_Shermie_wy","cd":4,"rate":100,"skill_story":"Ngẫu nhiên tấn công 1 mục tiêu địch, chuyển hóa tấn công t.tính Nước thành Ma Công, tạo effect% ST ma pháp.\nBất kỳ skill tấn công của Shermie, đều dồn 1-3 tầng hiệu quả Cảm Điện lên mục tiêu địch bị tấn công, mỗi tầng đều khiến sát thương tấn công kế tiếp của Shermie tăng 30%; Hiệu quả Cảm Điện kéo dài 3 hiệp sẽ mất, tối đa dồn 10 tầng.","effect_lvchange":7.0,"is_learn":0,"sprite_py":"Shermie_s1","skill_name":"Lôi Vân-Thánh.Cấp 2","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":5,"effect":300,"evo_story":"Yêu cầu: Tiến hóa +9","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":65912,"resource_count":0,"evo_food":30000,"action":0,"resource_type":0},"65912":{"effect_talent":0.0,"attr_effect":350,"skill_icon":"s_Shermie_wy","cd":4,"rate":100,"skill_story":"Ngẫu nhiên tấn công 1 mục tiêu địch, chuyển hóa tấn công t.tính Nước thành Ma Công, tạo effect% ST ma pháp.\nBất kỳ skill tấn công của Shermie, đều dồn 1-3 tầng hiệu quả Cảm Điện lên mục tiêu địch bị tấn công, mỗi tầng đều khiến sát thương tấn công kế tiếp của Shermie tăng 30%; Hiệu quả Cảm Điện kéo dài 3 hiệp sẽ mất, tối đa dồn 10 tầng.","effect_lvchange":8.0,"is_learn":0,"sprite_py":"Shermie_s1","skill_name":"Lôi Vân-Thánh.Cấp 3","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":6,"effect":350,"evo_story":"Yêu cầu: Tiến hóa +16","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":65913,"resource_count":0,"evo_food":60000,"action":0,"resource