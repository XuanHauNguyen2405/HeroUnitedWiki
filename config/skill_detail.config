effect% ST ma công và % ST t.tính Lửa lên toàn thể địch, mỗi lần nổ đều tạo dư âm, mỗi đạn nổ đều kèm thêm ST bằng một nửa Ma Công.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"shalu_s4","skill_name":"Xạ Kích Đạn Sáng","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":500,"evo_story":"Dùng Xu để mở skill này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"90077":{"effect_talent":0.0,"attr_effect":0,"skill_icon":"s_chaojiwangzi.png","cd":99,"rate":100,"skill_story":"Kĩ năng trước trận. Biến thân thành trạng thái siêu cấp, kéo dài 2 hiệp. Tăng effect% sát thương ma pháp, phòng ngự, tốc độ và giới hạn HP, mỗi hiệp có thể hồi phục 10% HP.","effect_lvchange":0.8,"is_learn":1,"sprite_py":"gmonkey_s3_1","skill_name":"Siêu Saiya","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":6,"evo_story":"Yêu cầu: Tiến hóa+4","skill_type":"KBEFOREBATTLE","attack_effect":"","is_evolution":4131,"resource_count":10000,"evo_food":5000,"action":3,"resource_type":3},"90078":{"effect_talent":0.0,"attr_effect":160,"skill_icon":"s_mingshenmen","cd":2,"rate":100,"skill_story":"Dùng Minh Giới Ma Kiếm đâm kẻ địch có tấn công cao nhất phe địch, tạo effect% sát thương ma pháp lên địch, giảm 30% tấn công vật lí và ma pháp của mục tiêu (BUFF này không thể xóa), kéo dài 2 hiệp. Tạo thêm 160% sát thương thuộc tính lửa của bản thân.","effect_lvchange":4.0,"is_learn":0,"sprite_py":"ghadisi_s1_1","skill_name":"Minh Giới Đột Thích","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":110,"evo_story":"","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":6811,"resource_count":0,"evo_food":5000,"action":0,"resource_type":0},"90079":{"effect_talent":0.0,"attr_effect":130,"skill_icon":"s_dibaotianxing","cd":2,"rate":100,"skill_story":"Phát động sức mạnh minh giới đi qua đi lại giữa nhân gian và minh giới, trảm kích mãnh liệt toàn bộ địch tạo effect% sát thương ma pháp, tạo gấp đôi sát thương với kẻ địch có 25% HP trở xuống. Tạo thêm 130% sát thương thuộc tính lửa của bản thân.","effect_lvchange":2.0,"is_learn":0,"sprite_py":"hadisi_s2_1","skill_name":"U Hồn Trảm","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":100,"evo_story":"Yêu cầu: Tiến hóa+2","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":6821,"resource_count":0,"evo_food":5000,"action":0,"resource_type":0},"90080":{"effect_talent":0.0,"attr_effect":10,"skill_icon":"s_lingti.png","cd":1,"rate":100,"skill_story":"Thân là vua minh giới có vô số linh hồn cung cấp sức mạnh bất tử cho hắn, tử vong xong hồi sinh (mỗi trận chiến chỉ được dùng 1 lần), hồi sinh xong giới hạn HP giảm 30%, đồng thời tăng effect% tất cả thuộc tính bản thân, kéo dài 2 hiệp, giảm sát thương 20%","effect_lvchange":0.5,"is_learn":0,"sprite_py":"hadisi_s3_1","skill_name":"Vua U Minh","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":15,"evo_story":"Yêu cầu: Tiến hóa+4","skill_type":"KDEAD","attack_effect":"","is_evolution":6831,"resource_count":0,"evo_food":5000,"action":0,"resource_type":0},"90081":{"effect_talent":0.0,"attr_effect":0,"skill_icon":"s_chaojiwangzi.png","cd":99,"rate":100,"skill_story":"Kĩ năng trước trận. Dùng đấu chí mạnh mẽ cổ vụ toàn bộ đồng đội, tăng effect% vật công cho toàn bộ đội viên, kéo dài 2 hiệp.","effect_lvchange":0.8,"is_learn":1,"sprite_py":"luffy_s1_1","skill_name":"Vua Hải Tặc","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":4,"effect":6,"evo_story":"","skill_type":"KBEFOREBATTLE","attack_effect":"","is_evolution":2311,"resource_count":10000,"evo_food":5000,"action":3,"resource_type":3},"90082":{"effect_talent":0.0,"attr_effect":160,"skill_icon":"s_JETluanda.png","cd":2,"rate":100,"skill_story":"Tạo effect% sát thương vật lí lên mục tiêu, nếu lúc này mục tiêu ở trạng thái chảy máu thì tạo thêm 30% sát thương, đồng thời làm choáng 1 hiệp. Tạo thêm 160% sát thương thuộc tính đất của bản thân.","effect_lvchange":2.0,"i