n.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"yuzhibodaitu_s4","skill_name":"Hỏa Viêm Trận","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":500,"evo_story":"Có thể dùng Xu mở khóa kỹ năng này","skill_type":"KBEFOREBATTLE","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"222250":{"effect_talent":0.0,"attr_effect":700,"skill_icon":"s_Shermie_myzs","cd":2,"rate":100,"skill_story":"引动天雷攻击敌方全体目标，将自身水属性攻击转化为魔法攻击，无视目标减伤，对目标造成effect%的魔法伤害，若攻击目标当前生命剩余量超过80%，则额外造成1倍伤害（对BOSS无效）。\n\n夏尔米任意攻击技，都会使敌方被攻击的目标叠加1~3层感电效果，每层感电效果都会使夏尔米的后续攻击伤害提高30%；感电效果持续3回合后消失，最多叠加10层。","effect_lvchange":10.0,"is_learn":0,"sprite_py":"boss_Shermie_s5","skill_name":"命运之矢","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":600,"evo_story":"花费钻石即可开启该技能","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"25650":{"effect_talent":0.0,"attr_effect":900,"skill_icon":"s_yuzhibodaitu_s5","cd":2,"rate":100,"skill_story":"Gây effect% sát thương ma pháp và 900% sát thương thuộc tính Lửa lên toàn bộ địch, trước khi tấn công tăng thêm 100 vạn ~ 180 vạn tấn công thuộc tính Lửa và 50 vạn ~ 80 vạn tấn công ma pháp, kéo dài 2 hiệp, khiến mục tiêu Tsukuyomi hoặc choáng, kéo dài 2 hiệp.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"yuzhibodaitu_s5","skill_name":"Thuật Phụng Tiên Hoa","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":600,"evo_story":"Có thể dùng Xu mở khóa kỹ năng này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"222260":{"effect_talent":0.0,"attr_effect":600,"skill_icon":"s_Shermie_khld","cd":1,"rate":100,"skill_story":"被动技：提高自身100%的速度、暴击率，600%的防御和属性防御；并将自身的整体减伤提高79%。","effect_lvchange":0.0,"is_learn":0,"sprite_py":"boss_Shermie_s6","skill_name":"荒狂雷电","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":100,"evo_story":"","skill_type":"KBEATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"25660":{"effect_talent":0.0,"attr_effect":800,"skill_icon":"s_yuzhibodaitu_s6","cd":1,"rate":100,"skill_story":"Skill trước hiệp: tất cả tấn công thuộc tính chuyển thành ma công, gây effect% sát thương ma pháp và 800% sát thương thật sự thuộc tính Lửa lên toàn bộ địch, khiến mục tiêu Tsukuyomi hoặc choáng, kéo dài 2 hiệp, gây hiệu quả Cháy lên tất cả mục tiêu, mỗi hiệp gây effect% sát thương thật sự của tấn công thuộc tính Lửa và 30% HP bản thân, kéo dài 2 hiệp.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"yuzhibodaitu_s6","skill_name":"Bạo Phong Loạn Vũ","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":800,"evo_story":"","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"26122":{"effect_talent":0.0,"attr_effect":400,"skill_icon":"s_chitong_s2","cd":4,"rate":100,"skill_story":"Tạo effect% ST Vật Lý và 400% ST thuộc tính Đất lên toàn thể phe địch, giảm 100% Phòng Ngự thuộc tính Nước và Phòng Ngự thuộc tính Đất của mục tiêu, kéo dài 2 hiệp. ","effect_lvchange":3.0,"is_learn":0,"sprite_py":"chitong_s2","skill_name":"Phá Giáp.Cấp 3","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":6,"effect":300,"evo_story":"Điều kiện tiến cấp: Đồng đội tiến cấp +20","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":26123,"resource_count":0,"evo_food":60000,"action":0,"resource_type":0},"222270":{"effect_talent":0.0,"attr_effect":600,"skill_icon":"s_Shermie_al","cd":1,"rate":100,"skill_story":"回合前技能：将雷电缠绕全身，使自身无视沉默、石化、冰封、月读1回合，同时使自身获得一次无敌效果，恢复自身已损失生命值的50%；并使本回合内，自身释放的主动攻击技能和普攻，拥有50%的概率使一个目标重伤，使该目标生命恢复能力降低70%；本回合内队友释放主动技能或普攻，都会使其攻击的目标降低防御值，降低量相当于夏尔米自身防御值的50%，生效2回合，最多叠加5层（夏尔米的攻击不包含该效果）。","effect_lvchange":0.0,"is_learn":0,"sprite_py":"boss_Shermie_s7","skill_name":"暗雷","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":600,"evo_story":"","s