"effect_lvchange":10.0,"is_learn":0,"sprite_py":"zilaiyexianren_s6","skill_name":"Siêu Đại Ngọc La Toàn","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":650,"evo_story":"","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"25350":{"effect_talent":0.0,"attr_effect":900,"skill_icon":"s_zilaiye_s5","cd":2,"rate":100,"skill_story":"Gây effect% sát thương ma pháp và sát thương thật sự thuộc tính Đất bằng 900% tổng toàn bộ thuộc tính lên toàn bộ địch, ngẫu nhiên khiến mục tiêu mù hoặc hỗn loạn, kéo dài 2 hiệp, hồi phục lượng HP bằng 20% giới hạn HP","effect_lvchange":10.0,"is_learn":0,"sprite_py":"zilaiye_s5","skill_name":"Thổ Lưu Hoãn","max_lv":30,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":800,"evo_story":"Có thể dùng Xu mở khóa kỹ năng này","skill_type":"KBEFOREATTACK","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"25360":{"effect_talent":0.0,"attr_effect":800,"skill_icon":"s_zilaiye_s6","cd":1,"rate":100,"skill_story":"Skill trước hiệp: tất cả tấn công thuộc tính chuyển thành ma công, gây effect% sát thương ma pháp và 800% sát thương thật sự thuộc tính Đất lên toàn bộ địch, hồi phục 30% ~ 40% HP cho toàn đội, 50% tỉ lệ giảm 30% ~ 60% tốc độ của mục tiêu. Kéo dài 2 hiệp.","effect_lvchange":10.0,"is_learn":0,"sprite_py":"zilaiye_s6","skill_name":"Loạn Sư Phát Thuật","max_lv":1,"pre_cd":0,"effect_delay":0,"skill_quality":7,"effect":600,"evo_story":"","skill_type":"KBEFOREROUND","attack_effect":"","is_evolution":0,"resource_count":0,"evo_food":0,"action":0,"resource_type":0},"25370":{"effect_talent":0.0,"attr_effect":800,"skill_icon":"s_zilaiye_s7","cd":0,"rate":100,"skill_story":"Skill tử trận: tử vong xong hồi sinh, hồi phục toàn bộ HP. Gây effect% sát thương ma pháp và 800% sát thương thật sự thuộc tính Đất lên toàn bộ địch. Tối đa hồi sinh 2 lần.","effect_lvchange":0.0,"is_learn":0,"sprite_py":"zilaiye_s7","skill_